---
import "../styles/article-list.css";

import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { openGraph } from "spectre:globals";
import Layout from "../layouts/Layout.astro";

const projects = await getCollection("projects");
const sortedProjects = [...projects].sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout
	title={openGraph.projects.title || "Projects"}
	description={openGraph.projects.description}
	layout="single"
>
	<article class="page-index">
		<header class="page-hero">
			<p class="page-eyebrow">Index</p>
			<h1 class="page-title">Projects</h1>
			<p class="page-lede">
				Things I'm building, iterating on, or thinking through.
			</p>
		</header>

		<hr class="hairline" />

		<div class="projects-list">
			{
				sortedProjects.map((post) => (
					<a href={`/projects/${post.id}`} class="project-item">
						{post.data.image && (
							<div class="project-image">
								<Image
									src={post.data.image}
									alt={post.data.title}
									width={1185}
									height={500}
									quality={90}
								/>
							</div>
						)}
						<div class="project-copy">
							<div class="project-header">
								<h2 class="project-title">{post.data.title}</h2>
								<span class="project-date">
									{post.data.date.toLocaleDateString()}
								</span>
							</div>
							<p class="project-description">{post.data.description}</p>
						</div>
					</a>
				))
			}
		</div>
	</article>
</Layout>

<style>
	.page-index {
		width: 100%;
	}

	.page-hero {
		padding: 3rem 0 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.page-eyebrow {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.76rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--text-tertiary);
	}

	.page-title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 450;
		font-size: clamp(2.4rem, 5vw, 3.5rem);
		letter-spacing: -0.02em;
		line-height: 1.05;
		font-variation-settings:
			"opsz" 144,
			"SOFT" 30;
	}

	.page-lede {
		margin: 0.25rem 0 0;
		color: var(--text-secondary);
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1rem;
	}

	.projects-list {
		display: flex;
		flex-direction: column;
	}

	.project-item {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding: 2rem 0;
		border-top: 1px solid var(--hairline);
		color: var(--text-primary);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.project-item:first-child {
		border-top: none;
	}

	.project-item:hover,
	.project-item:focus-visible {
		color: var(--primary);
		outline: none;
		text-decoration: none;
	}

	.project-item:hover .project-title,
	.project-item:focus-visible .project-title {
		color: var(--primary);
	}

	.project-image {
		overflow: hidden;
	}

	.project-image :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}

	.project-copy {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.project-header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.35rem 1rem;
	}

	.project-title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 450;
		font-size: clamp(1.6rem, 2.5vw, 2rem);
		letter-spacing: -0.015em;
		line-height: 1.15;
		color: var(--text-primary);
		transition: color 0.15s ease;
	}

	.project-date {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-tertiary);
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.project-description {
		margin: 0;
		color: var(--text-secondary);
		line-height: 1.6;
	}

	@media screen and (max-width: 640px) {
		.page-hero {
			padding: 1.5rem 0 1rem;
		}

		.project-item {
			padding: 1.5rem 0;
		}
	}
</style>
