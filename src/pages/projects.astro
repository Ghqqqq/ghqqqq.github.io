---
import "../styles/article-list.css";
import "../styles/atlas-index.css";

import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { openGraph } from "homepage:globals";
import AtlasIndexHero from "../components/AtlasIndexHero.astro";
import Layout from "../layouts/Layout.astro";

const projects = await getCollection("projects");
const sortedProjects = [...projects].sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const formatProjectDate = (date: Date) =>
	new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric" })
		.format(date)
		.toUpperCase();
---

<Layout
	title={openGraph.projects.title || "Projects"}
	description={openGraph.projects.description}
	layout="home"
	ambient="manuscript"
>
	<article class="atlas-index-page projects-index-page">
		<AtlasIndexHero
			eyebrow="Working systems"
			title="Projects"
			lede="Research tools and open systems developed through iterative experiments, model work, and real workflows."
			meta={`${sortedProjects.length} active builds`}
			compact
		/>

		<div class="atlas-index-content">
			<div class="projects-list">
			{
				sortedProjects.map((post, projectIndex) => (
					<a href={`/projects/${post.id}`} class="project-item">
						{post.data.image && (
							<div class="project-image">
								<Image
									src={post.data.image}
									alt={post.data.title}
									width={1185}
									height={500}
									quality={90}
								/>
							</div>
						)}
						<div class="project-copy">
							<span class="project-index">
								{String(projectIndex + 1).padStart(2, "0")}
							</span>
							<div class="project-header">
								<h2 class="project-title">{post.data.title}</h2>
								<span class="project-date">
									{formatProjectDate(post.data.date)}
								</span>
							</div>
							<p class="project-description">{post.data.description}</p>
						</div>
					</a>
				))
			}
			</div>
		</div>
	</article>
</Layout>

<style>
	.projects-list {
		display: flex;
		max-width: 74rem;
		margin: 0 auto;
		flex-direction: column;
	}

	.project-item {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(16rem, 0.75fr);
		grid-template-areas: "image copy";
		align-items: center;
		gap: clamp(2rem, 5vw, 5rem);
		min-width: 0;
		padding: clamp(2.75rem, 5vw, 4.5rem) 0;
		border-top: 1px solid color-mix(in srgb, var(--primary) 36%, transparent);
		background: transparent;
		color: var(--text-primary);
		text-decoration: none;
		transition: color 180ms ease;
	}

	.project-item:first-child {
		padding-top: 0;
		border-top: 0;
	}

	.project-item:hover,
	.project-item:focus-visible {
		color: var(--primary-light);
		outline: none;
		text-decoration: none;
	}

	.project-item:hover .project-title,
	.project-item:focus-visible .project-title {
		color: var(--primary-light);
	}

	.project-item:hover .project-image,
	.project-item:focus-visible .project-image {
		border-color: var(--primary-light);
	}

	.project-image {
		grid-area: image;
		overflow: hidden;
		aspect-ratio: 1185 / 500;
		border: 1px solid color-mix(in srgb, var(--primary) 30%, transparent);
		background: var(--home-surface);
		transition: border-color 180ms ease;
	}

	.project-image :global(img) {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
	}

	.project-copy {
		grid-area: copy;
		display: flex;
		flex-direction: column;
		align-self: center;
		gap: 0.8rem;
		padding: 0;
	}

	.project-index {
		color: var(--primary-light);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0;
	}

	.project-header {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.project-title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 450;
		font-size: clamp(1.65rem, 2.5vw, 2.2rem);
		letter-spacing: 0;
		line-height: 1.15;
		color: var(--text-primary);
		transition: color 0.15s ease;
	}

	.project-date {
		order: -1;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-tertiary);
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.project-description {
		margin: 0;
		color: var(--text-secondary);
		line-height: 1.6;
	}

	@media screen and (max-width: 760px) {
		.project-item {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				"image"
				"copy";
			gap: 1.5rem;
			padding: 2.5rem 0;
		}

		.project-copy {
			gap: 0.65rem;
		}
	}
</style>
