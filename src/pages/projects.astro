---
import "../styles/article-list.css";
import "../styles/atlas-index.css";

import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { openGraph } from "homepage:globals";
import AtlasIndexHero from "../components/AtlasIndexHero.astro";
import Layout from "../layouts/Layout.astro";

const projects = await getCollection("projects");
const sortedProjects = [...projects].sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const formatProjectDate = (date: Date) =>
	new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric" })
		.format(date)
		.toUpperCase();
---

<Layout
	title={openGraph.projects.title || "Projects"}
	description={openGraph.projects.description}
	layout="home"
	ambient="manuscript"
>
	<article class="atlas-index-page projects-index-page">
		<AtlasIndexHero
			eyebrow="Working systems"
			title="Projects"
			lede="Research tools and open systems developed through iterative experiments, model work, and real workflows."
			meta={`${sortedProjects.length} active builds`}
		/>

		<div class="atlas-index-content">
			<div class="projects-list">
			{
				sortedProjects.map((post) => (
					<a href={`/projects/${post.id}`} class="project-item">
						{post.data.image && (
							<div class="project-image">
								<Image
									src={post.data.image}
									alt={post.data.title}
									width={1185}
									height={500}
									quality={90}
								/>
							</div>
						)}
						<div class="project-copy">
							<div class="project-header">
								<h2 class="project-title">{post.data.title}</h2>
								<span class="project-date">
									{formatProjectDate(post.data.date)}
								</span>
							</div>
							<p class="project-description">{post.data.description}</p>
						</div>
					</a>
				))
			}
			</div>
		</div>
	</article>
</Layout>

<style>
	.projects-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
		border: 1px solid color-mix(in srgb, var(--primary) 38%, transparent);
		background: color-mix(in srgb, var(--primary) 38%, transparent);
	}

	.project-item {
		display: grid;
		grid-template-rows: auto minmax(0, 1fr);
		gap: 0;
		min-width: 0;
		border: 0;
		background: color-mix(in srgb, var(--home-surface) 94%, transparent);
		color: var(--text-primary);
		text-decoration: none;
		transition:
			background-color 180ms ease,
			color 180ms ease;
	}

	.project-item:hover,
	.project-item:focus-visible {
		color: var(--primary-light);
		background: color-mix(in srgb, var(--primary) 8%, var(--home-surface));
		outline: none;
		text-decoration: none;
	}

	.project-item:hover .project-title,
	.project-item:focus-visible .project-title {
		color: var(--primary-light);
	}

	.project-image {
		overflow: hidden;
		aspect-ratio: 1185 / 500;
		border-bottom: 1px solid color-mix(in srgb, var(--primary) 24%, transparent);
		background: var(--home-surface);
	}

	.project-image :global(img) {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
	}

	.project-copy {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: clamp(1.2rem, 2.5vw, 1.8rem);
	}

	.project-header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.35rem 1rem;
	}

	.project-title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 450;
		font-size: clamp(1.65rem, 2.5vw, 2.2rem);
		letter-spacing: 0;
		line-height: 1.15;
		color: var(--text-primary);
		transition: color 0.15s ease;
	}

	.project-date {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-tertiary);
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.project-description {
		margin: 0;
		color: var(--text-secondary);
		line-height: 1.6;
	}

	@media screen and (max-width: 760px) {
		.projects-list {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
