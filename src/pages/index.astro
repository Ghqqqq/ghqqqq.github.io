---
import "../styles/index.css";

import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import { name, openGraph } from "spectre:globals";
import ProfilePicture from "../assets/profile-bird-original.png";
import PublicationTeaser from "../components/PublicationTeaser.astro";
import Layout from "../layouts/Layout.astro";

const [
	publications,
	about,
	quickInfo,
	socials,
	awards,
	experience,
	serviceTeaching,
] = await Promise.all([
	getCollection("publications"),
	getEntry("other", "about"),
	getCollection("quickInfo"),
	getCollection("socials"),
	getCollection("awards"),
	getCollection("experience"),
	getCollection("serviceTeaching"),
]);

const { Content: About } = await render(about!);

const formatKindLabel = (kind: "service" | "teaching" | "talk") =>
	kind.charAt(0).toUpperCase() + kind.slice(1);

const splitAwardMeta = (meta?: string, year?: number) => {
	const compactMeta = meta?.trim();
	const yearLabel = year
		? String(year)
		: compactMeta && /^\d{4}\s*-\s*\d{4}$/.test(compactMeta)
			? compactMeta
			: undefined;
	const inlineMeta = yearLabel === compactMeta ? undefined : compactMeta;

	return { inlineMeta, yearLabel };
};

const selectedPublications = publications
	.filter((publication) => publication.data.selected)
	.sort(
		(a, b) =>
			b.data.year - a.data.year ||
			b.data.createdAt.getTime() - a.data.createdAt.getTime(),
	);

const publicationSections = [
	{
		id: "agent-llm-alignment",
		title: "Agent / LLM Alignment",
	},
	{
		id: "recommendation-bidding",
		title: "Recommendation & Bidding",
	},
	{
		id: "reinforcement-learning-bandits",
		title: "Reinforcement Learning & Bandits",
	},
].map((section) => ({
	...section,
	publications: selectedPublications.filter(
		(publication) => publication.data.homepageCategory === section.id,
	),
}));

const sortedSocials = [...socials].sort((a, b) => a.data.id - b.data.id);
const sortedQuickInfo = [...quickInfo].sort((a, b) => a.data.id - b.data.id);
const sortedExperience = [...experience].sort((a, b) => a.data.id - b.data.id);
const sortedAwards = [...awards].sort(
	(a, b) => (b.data.year ?? 0) - (a.data.year ?? 0),
);
const sortedServiceTeaching = [...serviceTeaching].sort(
	(a, b) => a.data.id - b.data.id,
);

type Section = {
	num: string;
	title: string;
};

const sections: Section[] = [
	{ num: "01", title: "About" },
	{ num: "02", title: "Experience" },
	{ num: "03", title: "Awards" },
	{ num: "04", title: "Service & Teaching" },
	{ num: "05", title: "Selected Publications" },
];
---

<Layout
	title={openGraph.home.title || name}
	description={openGraph.home.description}
	layout="single"
>
	<article class="home" data-home-motion>
		<header class="hero" data-reveal>
			<div class="hero-text">
				<h1 class="hero-name">{name}</h1>
				<p class="hero-tagline">
					PhD student, ShanghaiTech University
				</p>
				<p class="hero-lede">
					Working on reinforcement learning and bandits — theory, and
					applications.
				</p>
				<div class="hero-links" aria-label="Profile links">
					{
						sortedSocials.map((item, i) => (
							<>
								{item.data.link ? (
									<a
										href={item.data.link}
										class="hero-link"
										target={
											item.data.link.startsWith("http")
												? "_blank"
												: undefined
										}
										rel={
											item.data.link.startsWith("http")
												? "noopener noreferrer"
												: undefined
										}
									>
										{item.data.text}
									</a>
								) : (
									<span class="hero-link hero-link-text">
										{item.data.text}
									</span>
								)}
								{i < sortedSocials.length - 1 && (
									<span class="hero-link-sep" aria-hidden="true">·</span>
								)}
							</>
						))
					}
				</div>
			</div>
			<div class="hero-avatar">
				<Image
					src={ProfilePicture}
					alt="Blue bird portrait of Hengquan Guo"
					width={288}
					height={288}
					quality={100}
					loading="eager"
				/>
			</div>
		</header>

		<hr class="hairline hero-hairline" data-draw-line />

		<section class="home-section" id="about" data-reveal>
			<header class="section-head">
				<span class="section-num">{sections[0].num}</span>
				<h2 class="section-title">{sections[0].title}</h2>
			</header>
			<div class="section-body">
				<div class="prose">
					<About />
				</div>
				<p class="interest-inline">
					<span class="interest-inline-label">Research interests</span>
					<span class="interest-inline-sep" aria-hidden="true">—</span>
					<span class="interest-inline-items">
						{
							sortedQuickInfo.map((info, i) => (
								<>
									<span>{info.data.text}</span>
									{i < sortedQuickInfo.length - 1 && (
										<span class="interest-inline-bullet" aria-hidden="true">
											·
										</span>
									)}
								</>
							))
						}
					</span>
				</p>
			</div>
		</section>

		<hr class="hairline" data-draw-line />

		<section class="home-section" id="experience" data-reveal>
			<header class="section-head">
				<span class="section-num">{sections[1].num}</span>
				<h2 class="section-title">{sections[1].title}</h2>
			</header>
			<div class="section-body">
				<div class="entry-list">
					{
						sortedExperience.map((item) => (
							<div class="entry">
								<div class="entry-header">
									<h3 class="entry-title">{item.data.title}</h3>
									<span class="entry-date">{item.data.period}</span>
								</div>
								<p class="entry-meta">{item.data.organization}</p>
								{item.data.description && (
									<p class="entry-description">{item.data.description}</p>
								)}
								{item.data.outcomes && item.data.outcomes.length > 0 && (
									<div class="entry-outcomes">
										<span class="entry-outcomes-label">Outcomes</span>
										<ul class="entry-outcomes-list">
											{item.data.outcomes.map((outcome) => (
												<li>{outcome}</li>
											))}
										</ul>
									</div>
								)}
							</div>
						))
					}
				</div>
			</div>
		</section>

		<hr class="hairline" data-draw-line />

		<section class="home-section" id="awards" data-reveal>
			<header class="section-head">
				<span class="section-num">{sections[2].num}</span>
				<h2 class="section-title">{sections[2].title}</h2>
			</header>
			<div class="section-body">
				<ul class="award-list">
					{
						sortedAwards.map((award) => {
							const { inlineMeta, yearLabel } = splitAwardMeta(
								award.data.meta,
								award.data.year,
							);

							return (
								<li class="award-item">
									<div class="award-title">{award.data.title}</div>
									{(inlineMeta || yearLabel) && (
										<div class="award-sub">
											{inlineMeta && (
												<span class="award-meta">{inlineMeta}</span>
											)}
											{inlineMeta && yearLabel && (
												<span class="award-sep" aria-hidden="true">·</span>
											)}
											{yearLabel && (
												<span class="award-year">{yearLabel}</span>
											)}
										</div>
									)}
								</li>
							);
						})
					}
				</ul>
			</div>
		</section>

		<hr class="hairline" data-draw-line />

		<section class="home-section" id="service" data-reveal>
			<header class="section-head">
				<span class="section-num">{sections[3].num}</span>
				<h2 class="section-title">{sections[3].title}</h2>
			</header>
			<div class="section-body">
				<ul class="entry-list-compact service-list">
					{
						sortedServiceTeaching.map((item) => (
							<li class="entry-compact service-item">
								<div class="service-heading">
									<span class="entry-compact-title">{item.data.title}</span>
									<span class="service-kind">
										{formatKindLabel(item.data.kind)}
									</span>
								</div>
								<div class="service-meta">{item.data.meta}</div>
								{item.data.notePrefix && (
									<div class="service-note">
										{item.data.notePrefix}
										{item.data.noteLink && item.data.noteLinkLabel ? (
											<a href={item.data.noteLink}>
												{item.data.noteLinkLabel}
											</a>
										) : (
											item.data.noteLinkLabel
										)}
										{item.data.noteSuffix}
									</div>
								)}
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<hr class="hairline" data-draw-line />

		<section class="home-section" id="publications" data-reveal>
			<header class="section-head">
				<span class="section-num">{sections[4].num}</span>
				<h2 class="section-title">{sections[4].title}</h2>
			</header>
			<div class="section-body">
				<div class="publication-groups">
					{
						publicationSections.map(
							(section) =>
								section.publications.length > 0 && (
									<section class="publication-group">
										<h3 class="publication-group-title">{section.title}</h3>
										<div class="publication-list">
											{section.publications.map((publication) => (
												<PublicationTeaser
													publication={publication}
													href={`/publications/${publication.id}`}
													variant="list"
												/>
											))}
										</div>
									</section>
								),
						)
					}
				</div>
			</div>
		</section>
	</article>

	<script is:inline>
		(() => {
			const root = document.querySelector("[data-home-motion]");

			if (!root) return;

			const prefersReducedMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;
			const revealItems = Array.from(root.querySelectorAll("[data-reveal]"));
			const drawnLines = Array.from(root.querySelectorAll("[data-draw-line]"));

			const finishImmediately = () => {
				for (const item of revealItems) item.classList.add("is-in");
				for (const line of drawnLines) line.classList.add("is-drawn");
			};

			if (prefersReducedMotion || !("IntersectionObserver" in window)) {
				finishImmediately();
				return;
			}

			root.setAttribute("data-motion-ready", "");

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;

						entry.target.classList.add("is-in");
						observer.unobserve(entry.target);
					}
				},
				{ rootMargin: "0px 0px -10% 0px", threshold: 0.12 },
			);

			const lineObserver = new IntersectionObserver(
				(entries, observer) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;

						entry.target.classList.add("is-drawn");
						observer.unobserve(entry.target);
					}
				},
				{ rootMargin: "0px 0px -8% 0px", threshold: 0.2 },
			);

			revealItems.forEach((item, index) => {
				item.style.setProperty("--reveal-delay", `${Math.min(index, 5) * 45}ms`);
				revealObserver.observe(item);
			});

			for (const line of drawnLines) lineObserver.observe(line);
		})();
	</script>
</Layout>
