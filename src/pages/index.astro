---
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import Portrait from "../assets/profile-bird-original.png";
import AtlasPoster from "../components/atlas/AtlasPoster.astro";
import {
	fieldForPaper,
	fields,
	type Paper,
} from "../components/atlas/atlas-data";
import LineageLink from "../components/atlas/LineageLink.astro";
import SelectedPublications from "../components/atlas/SelectedPublications.astro";
import SurfaceControls from "../components/atlas/SurfaceControls.astro";
import SurveyFrame from "../components/atlas/SurveyFrame.astro";
import ErnieMark from "../components/ErnieMark.astro";
import ManuscriptLayer from "../components/ManuscriptLayer.astro";
import TencentWordmark from "../components/TencentWordmark.astro";
import Layout from "../layouts/Layout.astro";
import "../components/atlas/atlas.css";
import "../components/atlas/atlas-details.css";
import "../components/atlas/atlas-survey.css";

const [publications, about, experience, awards, services] = await Promise.all([
	getCollection("publications"),
	getEntry("other", "about"),
	getCollection("experience"),
	getCollection("awards"),
	getCollection("serviceTeaching"),
]);
const { Content: About } = await render(about!);
const ordered = [...publications].sort(
	(a, b) =>
		b.data.year - a.data.year ||
		b.data.createdAt.getTime() - a.data.createdAt.getTime(),
);
const papers: Paper[] = ordered.map(({ id, data }) => ({
	id,
	title: data.title,
	description: data.description,
	authors: data.authors,
	venue: data.venue,
	venueShort: data.venueShort,
	year: data.year,
	link: data.link,
	category: data.homepageCategory,
	selected: data.selected,
	lineage: data.lineage,
}));
const selected = papers.filter((p) => p.selected);
const readers = await Promise.all(
	ordered.map(async (paper) => ({ paper, ...(await render(paper)) })),
);
const experienceItems = [...experience].sort((a, b) => a.data.id - b.data.id);
const awardItems = [...awards].sort(
	(a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || a.data.id - b.data.id,
);
const years = [
	...new Set(
		awardItems.map((a) => (a.data.year ? String(a.data.year) : a.data.meta!)),
	),
];
const serviceItems = [...services].sort((a, b) => a.data.id - b.data.id);
const chapters = [
	{ id: "overview", label: "Overview" },
	{ id: "research", label: "Research" },
	{ id: "journey", label: "Experience" },
	{ id: "awards", label: "Awards" },
	{ id: "service", label: "Service" },
];
const paperYears = papers.map((paper) => paper.year);
const surveySpan = `${Math.min(...paperYears)}–${Math.max(...paperYears)}`;
const coordinate = "31.2304° N · 121.4737° E";
---

<Layout title="Hengquan Guo" description="Reinforcement learning and bandits, from theoretical foundations to agentic and multimodal systems." layout="home" ambient="none">
	<script is:inline>document.documentElement.dataset.atlasPhase = "overview"; document.documentElement.dataset.homeHero = "visible";</script>
	<script is:inline data-atlas-intro-gate>(() => { try { if (scrollY > 40 || location.hash || matchMedia("(prefers-reduced-motion: reduce)").matches || sessionStorage.getItem("atlas-intro")) return; sessionStorage.setItem("atlas-intro", "played"); document.documentElement.dataset.atlasIntro = ""; } catch {} })();</script>
	<article class="atlas-experience" data-atlas-experience data-view="map" data-field="all" data-surface="relief">
		<script type="application/json" id="atlas-paper-data" set:html={JSON.stringify(papers).replace(/</g,"\\u003c")} />
		<div class="atlas-world" data-atlas-world aria-hidden="true"></div>
		<div class="atlas-manuscript" aria-hidden="true"><ManuscriptLayer /></div>
		<div class="chapter-cut" data-chapter-cut aria-hidden="true"><div class="chapter-cut-surface" data-chapter-cut-surface></div><svg class="chapter-cut-edge" viewBox="0 0 100 100" preserveAspectRatio="none"><line data-chapter-cut-edge x1="0" x2="100" y1="120" y2="120" /></svg></div>
		<div class="opening-crosshair" aria-hidden="true"><i></i><i></i><span>Atlas / Research terrain</span><span data-opening-coordinate>{coordinate}</span></div>
		<div class="atlas-annotations" data-atlas-annotations>
			{fields.map(field => <button class="field-pin" data-field-pin={field.id} data-select-field={field.id} type="button"><span class="field-pin-number">{field.number}</span><span class="field-pin-name">{field.short}</span><span class="field-pin-count">{selected.filter(p => p.category === field.category).length} selected works</span></button>)}
			{selected.map(paper => <button class="paper-pin" data-paper-pin={paper.id} data-read-paper={paper.id} type="button" aria-label={`${paper.title}, ${paper.venueShort ?? paper.venue}, ${paper.year}`}><span class="paper-pin-dot"></span></button>)}
			<div class="paper-preview" data-paper-preview aria-hidden="true" hidden><span data-preview-meta></span><strong data-preview-title></strong></div>
			<div class="reading-map-label" data-reading-map-label aria-hidden="true" hidden><span data-reading-map-meta></span><strong data-reading-map-title></strong></div>
		</div>
		<nav class="atlas-chapters" aria-label="Atlas chapters">
			{chapters.map((chapter,index) => <a href={`#${chapter.id}`} data-chapter-link={chapter.id}><span>0{index+1}</span><span>{chapter.label}</span></a>)}
			<span class="atlas-chapter-line" aria-hidden="true"></span>
		</nav>
		<nav class="atlas-timecode" aria-label="Chapter progress">
			{chapters.map(chapter => <a href={`#${chapter.id}`} data-chapter-link={chapter.id} data-timecode-step={chapter.id}><span class="atlas-timecode-name">{chapter.label}</span></a>)}
			<span class="atlas-timecode-index" data-timecode-index aria-hidden="true">01/{String(chapters.length).padStart(2, "0")}</span>
			<span class="atlas-timecode-label" data-timecode-label aria-hidden="true">{chapters[0].label}</span>
		</nav>

		<section id="overview" class="atlas-opening" data-atlas-section="overview">
			<div class="opening-copy">
				<p class="atlas-overline">Shanghai &middot; Reinforcement learning</p>
				<h1><span>Hengquan</span><span>Guo<span class="name-period">.</span></span></h1>
				<p class="opening-statement">Research as<br /><em>a living atlas.</em></p>
				<div class="opening-profile"><Image src={Portrait} alt="Hengquan Guo's blue bird portrait" width={64} height={64} loading="eager" /><p>PhD student<br /><span>ShanghaiTech University</span></p></div>
				<div class="opening-links"><a href="https://scholar.google.com/citations?user=8bGinucAAAAJ&hl=zh-CN" target="_blank" rel="noopener noreferrer">Google Scholar <span aria-hidden="true">↗</span></a><a href="mailto:guohq@shanghaitech.edu.cn">guohq (at) shanghaitech.edu.cn</a><a href="mailto:guohq46@qq.com">guohq46 (at) qq.com</a></div>
			</div>
			<div class="opening-map-space" data-scene-frame="overview" aria-hidden="true"><AtlasPoster priority /><SurveyFrame caption="Fig. 01 — Research terrain" coordinate={coordinate} meta={`${fields.length} fields · ${selected.length} selected · ${surveySpan}`} /></div>
			<SurfaceControls context="overview" />
			<div class="opening-fields">
				{fields.map(field => <a href="#research" data-select-field={field.id}><span>{field.number}</span><span>{field.short}</span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M5 19 19 5M6 5h13v13" /></svg></a>)}
			</div>
		</section>

		<section id="research" class="atlas-research" data-atlas-section="research">
			<div class="research-map-space" data-scene-frame="research" aria-hidden="true"><AtlasPoster /><SurveyFrame caption="Fig. 02 — Field survey" meta="Drag to orbit · select a field to descend" /></div>
			<header class="research-heading"><div><p class="atlas-overline">01 / Research &amp; selected work</p><h2>Research Atlas</h2></div><div class="view-control" role="group" aria-label="Publication view"><button type="button" data-view-button="map" aria-pressed="true" title="Atlas view" aria-label="Atlas view"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3Zm6-3v15M15 6v15" /></svg></button><button type="button" data-view-button="index" aria-pressed="false" title="Publication index" aria-label="Publication index"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h1M3 12h1M3 18h1" /></svg></button></div></header>
			<SelectedPublications papers={selected} />
			<div class="publication-index" data-publication-index>
				<div class="index-tools"><p>{papers.length} publications</p><label><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg><input type="search" aria-label="Search publications" placeholder="Search publications" data-paper-search /></label></div>
				{papers.map(paper => <a href={`/publications/${paper.id}`} class="index-paper" data-read-paper={paper.id} data-index-paper data-search-text={`${paper.title} ${paper.authors} ${paper.year} ${paper.venue}`.toLowerCase()}><span class="paper-year">{paper.year}</span><span><h3>{paper.title}</h3><p>{paper.authors}</p><small>{paper.venue}</small></span><span aria-hidden="true">↗</span></a>)}
				<p data-search-empty hidden>No matching publications.</p>
			</div>
			<div class="map-caption"><span data-map-caption>Reinforcement Learning &amp; Bandits</span><SurfaceControls context="research" /><div><button type="button" data-reset-camera aria-label="Reset map view" title="Reset map view"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 11a9 9 0 1 1 2.6 7M3 4v7h7" /></svg></button><button type="button" data-toggle-motion aria-label="Pause scene motion" title="Pause scene motion" aria-pressed="false"><svg data-pause-icon width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg><svg data-play-icon hidden width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m8 5 11 7-11 7Z" /></svg></button></div></div>
		</section>

		<section id="journey" class="atlas-journey reading-chapter" data-atlas-section="journey">
			<div class="chapter-intro"><p class="atlas-overline">02 / In practice</p><h2>Ideas into<br /><em>experience.</em></h2></div>
			<div class="journey-content">
				<div class="atlas-about"><About /></div>
				<div class="journey-entries">
					{experienceItems.map(({data}) => <article class="journey-entry">
						<div class="journey-date"><span>{data.period.split(".")[0]}</span><small>{data.period}</small></div>
						<div>
							<p class="atlas-overline">{data.title}</p>
							<h3 class="journey-organization">{data.logo === "tencent" ? <TencentWordmark class="journey-tencent" /> : <>{data.logo === "analemma" && <span class="journey-analemma" aria-hidden="true" />}{data.logo === "ernie" && <ErnieMark class="journey-ernie" />}<span>{data.organization}</span></>}</h3>
							{data.logo === "tencent" && <p class="journey-program">CDG &middot; Tencent Rhino-Bird Elite Talent Program</p>}
							<p>{data.description}</p>
						</div>
					</article>)}
				</div>
			</div>
		</section>

		<section id="awards" class="atlas-awards" data-atlas-section="awards">
			<header class="chapter-intro"><p class="atlas-overline">03 / Recognition</p><h2>Awards<span class="heading-period">.</span></h2></header>
			<div class="atlas-award-ledger">{years.map(year => <div class="atlas-award-year"><span>{year}</span><ul>{awardItems.filter(item => (item.data.year ? String(item.data.year) : item.data.meta)===year).map(({data}) => <li><h3>{data.title}</h3>{data.year && data.meta && <span class:list={[data.meta.startsWith("Top") && "award-signal"]}>{data.meta}</span>}</li>)}</ul></div>)}</div>
		</section>

		<section id="service" class="atlas-service reading-chapter" data-atlas-section="service">
			<header class="chapter-intro"><p class="atlas-overline">04 / Community</p><h2>Service<br /><em>&amp; teaching.</em></h2></header>
			<div class="atlas-service-list">{serviceItems.map(({data}) => <article><div><span class="atlas-overline">{data.kind}</span><h3>{data.title}</h3><p>{data.meta}</p></div></article>)}</div>
		</section>
	</article>

	<dialog class="atlas-reader" data-atlas-reader aria-label="Publication reader">
		<div class="reader-folio-position" data-reader-folio aria-hidden="true"></div>
		<div class="reader-toolbar"><span class="atlas-overline" data-reader-record>Research / Publication</span><div><span class="reader-position" data-reader-position aria-label="Publication position"></span><button data-reader-prev type="button" aria-label="Previous paper" title="Previous paper">←</button><button data-reader-next type="button" aria-label="Next paper" title="Next paper">→</button><button data-reader-close type="button" aria-label="Close publication" title="Close publication"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" /></svg></button></div></div>
		{readers.map(({paper,Content}) => <article class="reader-paper" data-reader-paper={paper.id} hidden>
			<p class="reader-year">{paper.data.year} <span>{paper.data.venueShort ?? "Research"}</span></p>
			<h2 tabindex="-1">{paper.data.title}</h2>
			<p class="reader-authors">{paper.data.authors}</p><p class="reader-venue">{paper.data.venue}</p>
			<div class="reader-links">{paper.data.link && <a href={paper.data.link} target="_blank" rel="noopener noreferrer">Paper <span aria-hidden="true">↗</span></a>}<a href={`/publications/${paper.id}`}>Publication page <span aria-hidden="true">↗</span></a></div>
			<div class="reader-prose">{paper.body?.trim() ? <Content /> : <p>{paper.data.description}</p>}</div>
			{paper.data.lineage && <LineageLink source={papers.find(p => p.id === paper.data.lineage?.sourceId)!} target={papers.find(p=>p.id===paper.id)!} direction="source" />}
			{papers.filter(p => p.lineage?.sourceId === paper.id).map(target => <LineageLink source={papers.find(p=>p.id===paper.id)!} target={target} direction="target" />)}
			<div class="reader-related"><p class="atlas-overline">In this direction</p>{selected.filter(p=>p.category===paper.data.homepageCategory&&p.id!==paper.id).slice(0,2).map(p=><a href={`/publications/${p.id}`} data-read-paper={p.id}><span>{p.year}</span>{p.title}<span aria-hidden="true">↗</span></a>)}</div>
		</article>)}
	</dialog>
	<script>
		import { mountAtlasExperience } from "../components/atlas/controller";
		mountAtlasExperience();
	</script>
</Layout>
