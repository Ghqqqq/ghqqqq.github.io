---
import "../styles/index.css";

import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import { name, openGraph } from "homepage:globals";
import ProfilePicture from "../assets/profile-bird-original.png";
import PublicationTeaser from "../components/PublicationTeaser.astro";
import ResearchAtlas from "../components/ResearchAtlas.astro";
import ResearchRelay from "../components/ResearchRelay.astro";
import TencentWordmark from "../components/TencentWordmark.astro";
import { homeSections } from "../data/research-atlas";
import Layout from "../layouts/Layout.astro";

const [publications, about, socials, awards, experience, serviceTeaching] =
	await Promise.all([
		getCollection("publications"),
		getEntry("other", "about"),
		getCollection("socials"),
		getCollection("awards"),
		getCollection("experience"),
		getCollection("serviceTeaching"),
	]);

const { Content: About } = await render(about!);

const formatKindLabel = (kind: "service" | "teaching" | "talk") =>
	kind.charAt(0).toUpperCase() + kind.slice(1);

const splitAwardMeta = (meta?: string, year?: number) => {
	const compactMeta = meta?.trim();
	const yearLabel = year
		? String(year)
		: compactMeta && /^\d{4}\s*-\s*\d{4}$/.test(compactMeta)
			? compactMeta
			: undefined;
	const inlineMeta = yearLabel === compactMeta ? undefined : compactMeta;

	return { inlineMeta, yearLabel };
};

const selectedPublications = publications
	.filter((publication) => publication.data.selected)
	.sort(
		(a, b) =>
			b.data.year - a.data.year ||
			b.data.createdAt.getTime() - a.data.createdAt.getTime(),
	);

const publicationSections = [
	{
		id: "agent-llm-alignment",
		title: "Agent / LLM Alignment",
	},
	{
		id: "recommendation-bidding",
		title: "Recommendation & Bidding",
	},
	{
		id: "reinforcement-learning-bandits",
		title: "Reinforcement Learning & Bandits",
	},
].map((section) => ({
	...section,
	publications: selectedPublications.filter(
		(publication) => publication.data.homepageCategory === section.id,
	),
}));

const visiblePublicationSections = publicationSections.filter(
	(section) => section.publications.length > 0,
);

const sortedSocials = [...socials].sort((a, b) => a.data.id - b.data.id);
const sortedExperience = [...experience].sort((a, b) => a.data.id - b.data.id);
const sortedAwards = [...awards].sort(
	(a, b) => (b.data.year ?? 0) - (a.data.year ?? 0),
);
const sortedServiceTeaching = [...serviceTeaching].sort(
	(a, b) => a.data.id - b.data.id,
);

const heroGridColumns = Array.from({ length: 9 }, (_, index) => index + 1);
const heroGridRows = Array.from({ length: 7 }, (_, index) => index + 1);
---

<Layout
	title={openGraph.home.title || name}
	description={openGraph.home.description}
	layout="home"
	ambient="none"
>
	<script is:inline data-atlas-boot>
		document.documentElement.dataset.atlasJs = "true";
	</script>
	<article class="home-atlas" data-home-atlas>
		<header class="atlas-hero" data-atlas-hero>
			<div class="atlas-hero-grid" aria-hidden="true">
				{heroGridColumns.map((line) => (
					<span
						class="atlas-hero-grid-line atlas-hero-grid-line--vertical"
						style={`--atlas-grid-line: ${line}`}
					/>
				))}
				{heroGridRows.map((line) => (
					<span
						class="atlas-hero-grid-line atlas-hero-grid-line--horizontal"
						style={`--atlas-grid-line: ${line}`}
					/>
				))}
			</div>
			<div class="atlas-hero-copy">
				<p class="atlas-hero-kicker">Decision-making under constraints · Shanghai</p>
				<h1 class="atlas-hero-name">{name}</h1>
				<p class="atlas-hero-statement">Research as <em>a living atlas.</em></p>
				<p class="atlas-hero-role">PhD student, ShanghaiTech University</p>
				<p class="atlas-hero-lede">
					Reinforcement learning and bandits, from theoretical foundations to
					agentic and multimodal systems.
				</p>
				<div class="atlas-hero-links" aria-label="Profile links">
					{sortedSocials.map((item) => item.data.link ? (
						<a href={item.data.link} target="_blank" rel="noopener noreferrer">
							{item.data.text}
						</a>
					) : (
						<span>{item.data.text}</span>
					))}
				</div>
			</div>
			<div class="atlas-hero-portrait">
				<span class="atlas-hero-orbit" aria-hidden="true"><span /></span>
				<Image
					src={ProfilePicture}
					alt="Blue bird portrait of Hengquan Guo"
					width={288}
					height={288}
					quality={100}
					loading="eager"
				/>
			</div>
			<div class="atlas-hero-coordinates" aria-hidden="true">
				31.2304° N · 121.4737° E<br />PhD · ShanghaiTech University
			</div>
			<div class="atlas-hero-map"><ResearchAtlas /></div>
		</header>

		<ResearchRelay sections={homeSections} />

		<section
			class="home-section"
			id="about"
			data-home-section="about"
			data-section-context={homeSections[0].context}
		>
			<header class="section-head">
				<span class="section-num">{homeSections[0].number}</span>
				<h2 class="section-title">{homeSections[0].label}</h2>
			</header>
			<div class="section-body">
				<div class="prose">
					<About />
				</div>
				<blockquote class="about-pull-quote">
					<p>Learning under constraints, feedback, and changing environments.</p>
				</blockquote>
			</div>
		</section>

		<hr class="hairline" />

		<section
			class="home-section"
			id="experience"
			data-home-section="experience"
			data-section-context={homeSections[1].context}
		>
			<header class="section-head">
				<span class="section-num">{homeSections[1].number}</span>
				<h2 class="section-title">{homeSections[1].label}</h2>
			</header>
			<div class="section-body">
				<div class="entry-list">
					{
						sortedExperience.map((item) => (
							<div class="entry">
								<div class="entry-header">
									<h3 class="entry-title">{item.data.title}</h3>
									<span class="entry-date">{item.data.period}</span>
								</div>
								<p class="entry-meta">
									{item.data.logo === "tencent" && (
										<TencentWordmark class="org-wordmark" />
									)}
									{item.data.logo === "analemma" && (
										<span
											class="org-mark org-mark-analemma"
											aria-hidden="true"
										/>
									)}
									{item.data.organization}
								</p>
								{item.data.description && (
									<p class="entry-description">{item.data.description}</p>
								)}
								{item.data.outcomes && item.data.outcomes.length > 0 && (
									<div class="entry-outcomes">
										<span class="entry-outcomes-label">Outcomes</span>
										<ul class="entry-outcomes-list">
											{item.data.outcomes.map((outcome) => (
												<li>{outcome}</li>
											))}
										</ul>
									</div>
								)}
							</div>
						))
					}
				</div>
			</div>
		</section>

		<hr class="hairline" />

		<section
			class="home-section home-section--blue"
			id="awards"
			data-home-section="awards"
			data-section-context={homeSections[2].context}
		>
			<header class="section-head">
				<span class="section-num">{homeSections[2].number}</span>
				<h2 class="section-title">{homeSections[2].label}</h2>
			</header>
			<div class="section-body">
				<ul class="award-list">
					{
						sortedAwards.map((award) => {
							const { inlineMeta, yearLabel } = splitAwardMeta(
								award.data.meta,
								award.data.year,
							);

							return (
								<li class="award-item">
									<div class="award-title">{award.data.title}</div>
									{(inlineMeta || yearLabel) && (
										<div class="award-sub">
											{inlineMeta && (
												<span class="award-meta">{inlineMeta}</span>
											)}
											{inlineMeta && yearLabel && (
												<span class="award-sep" aria-hidden="true">·</span>
											)}
											{yearLabel && (
												<span class="award-year">{yearLabel}</span>
											)}
										</div>
									)}
								</li>
							);
						})
					}
				</ul>
			</div>
		</section>

		<hr class="hairline" />

		<section
			class="home-section"
			id="service"
			data-home-section="service"
			data-section-context={homeSections[3].context}
		>
			<header class="section-head">
				<span class="section-num">{homeSections[3].number}</span>
				<h2 class="section-title">{homeSections[3].label}</h2>
			</header>
			<div class="section-body">
				<ul class="entry-list-compact service-list">
					{
						sortedServiceTeaching.map((item) => (
							<li class="entry-compact service-item">
								<div class="service-heading">
									<span class="entry-compact-title">{item.data.title}</span>
									<span class="service-kind">
										{formatKindLabel(item.data.kind)}
									</span>
								</div>
								<div class="service-meta">{item.data.meta}</div>
								{item.data.notePrefix && (
									<div class="service-note">
										{item.data.notePrefix}
										{item.data.noteLink && item.data.noteLinkLabel ? (
											<a href={item.data.noteLink}>
												{item.data.noteLinkLabel}
											</a>
										) : (
											item.data.noteLinkLabel
										)}
										{item.data.noteSuffix}
									</div>
								)}
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<hr class="hairline" />

		<section
			class="home-section"
			id="publications"
			data-home-section="publications"
			data-section-context={homeSections[4].context}
		>
			<header class="section-head">
				<span class="section-num">{homeSections[4].number}</span>
				<h2 class="section-title">{homeSections[4].label}</h2>
			</header>
			<div class="section-body">
				<div class="publication-groups">
					{
						visiblePublicationSections.map((section, sectionIndex) => (
							<section
								class="publication-group"
								id={`publications-${section.id}`}
								data-publication-group={section.id}
								data-publication-context={section.title}
							>
								<h3 class="publication-group-title">
									<span class="publication-group-index">
										{String(sectionIndex + 1).padStart(2, "0")}
									</span>
									<span class="publication-group-rule" aria-hidden="true" />
									<span class="publication-group-name">{section.title}</span>
								</h3>
								<div class="publication-list">
									{section.publications.map((publication) => (
										<PublicationTeaser
											publication={publication}
											href={`/publications/${publication.id}`}
											variant="list"
											showLineage={true}
										/>
									))}
								</div>
							</section>
						))
					}
				</div>
			</div>
		</section>
	</article>
</Layout>

<script is:inline data-atlas-controller>
	(() => {
		const root = document.querySelector("[data-home-atlas]");
		if (!(root instanceof HTMLElement)) return;

		const hero = root.querySelector("[data-atlas-hero]");
		const sections = Array.from(root.querySelectorAll("[data-home-section]"));
		const publicationGroups = Array.from(
			root.querySelectorAll("[data-publication-group]"),
		);
		const relayLinks = Array.from(root.querySelectorAll("[data-relay-link]"));
		const context = root.querySelector("[data-relay-context]");
		const intersectingPublicationGroups = new Set();
		let publicationGroupGeneration = 0;
		const publicationSection = sections.find(
			(section) => section.getAttribute("data-home-section") === "publications",
		);

		const syncResearchGroup = () => {
			if (root.dataset.activeSection !== "publications") return;

			const group = publicationGroups.find((candidate) =>
				intersectingPublicationGroups.has(candidate),
			);
			if (group) {
				const id = group.getAttribute("data-publication-group");
				const label = group.getAttribute("data-publication-context");
				if (id) root.dataset.activeResearchGroup = id;
				if (context && label) context.textContent = label;
				return;
			}

			delete root.dataset.activeResearchGroup;
			const label = publicationSection?.getAttribute("data-section-context");
			if (context && label) context.textContent = label;
		};

		const setSection = (section) => {
			const id = section.getAttribute("data-home-section");
			const label = section.getAttribute("data-section-context");
			if (!id) return;

			root.dataset.activeSection = id;
			if (id !== "publications") {
				publicationGroupGeneration += 1;
				intersectingPublicationGroups.clear();
				delete root.dataset.activeResearchGroup;
			}
			for (const link of relayLinks) {
				if (link.getAttribute("data-relay-link") === id) {
					link.setAttribute("aria-current", "location");
				} else {
					link.removeAttribute("aria-current");
				}
			}
			if (context && label) context.textContent = label;
			if (id === "publications") syncResearchGroup();
		};

		if (sections[0]) setSection(sections[0]);

		if (!("IntersectionObserver" in window)) {
			document.documentElement.dataset.homeHero = "passed";
			root.dataset.heroState = "passed";
			return;
		}

		if (hero) {
			document.documentElement.dataset.homeHero = "visible";
			root.dataset.heroState = "visible";
			new IntersectionObserver(
				([entry]) => {
					const state = entry?.isIntersecting ? "visible" : "passed";
					document.documentElement.dataset.homeHero = state;
					root.dataset.heroState = state;
				},
				{ threshold: 0.15 },
			).observe(hero);
		} else {
			document.documentElement.dataset.homeHero = "passed";
			root.dataset.heroState = "passed";
		}

		const sectionObserver = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) setSection(entry.target);
				}
			},
			{ rootMargin: "-32% 0px -52% 0px", threshold: 0 },
		);

		const groupObserver = new IntersectionObserver(
			(entries) => {
				publicationGroupGeneration += 1;
				const callbackGeneration = publicationGroupGeneration;
				for (const entry of entries) {
					if (entry.isIntersecting) {
						intersectingPublicationGroups.add(entry.target);
					} else {
						intersectingPublicationGroups.delete(entry.target);
					}
				}
				syncResearchGroup();
				if (root.dataset.activeSection !== "publications") {
					queueMicrotask(() => {
						if (callbackGeneration !== publicationGroupGeneration) return;
						if (root.dataset.activeSection === "publications") return;
						intersectingPublicationGroups.clear();
					});
				}
			},
			{ rootMargin: "-30% 0px -55% 0px", threshold: 0 },
		);

		for (const section of sections) sectionObserver.observe(section);
		for (const group of publicationGroups) groupObserver.observe(group);
	})();
</script>
