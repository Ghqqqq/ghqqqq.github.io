---
import "../styles/article-list.css";

import { getCollection } from "astro:content";
import { openGraph } from "spectre:globals";
import Layout from "../layouts/Layout.astro";
import PublicationTeaser from "../components/PublicationTeaser.astro";

const publications = (await getCollection("publications")).sort(
	(a, b) =>
		b.data.year - a.data.year ||
		b.data.createdAt.getTime() - a.data.createdAt.getTime(),
);
---

<Layout
	title={openGraph.blog.title || "Full Publications"}
	description={openGraph.blog.description}
	layout="single"
>
	<article class="page-index">
		<header class="page-hero">
			<p class="page-eyebrow">Index</p>
			<h1 class="page-title">Publications</h1>
			<p class="page-lede">
				{publications.length} paper{publications.length === 1 ? "" : "s"}, sorted by year.
			</p>
		</header>

		<hr class="hairline" />

		<div class="publication-list full-publications-list">
			{
				publications.map((publication) => (
					<PublicationTeaser
						publication={publication}
						href={`/publications/${publication.id}`}
						variant="list"
					/>
				))
			}
		</div>
	</article>
</Layout>

<style>
	.page-index {
		width: 100%;
	}

	.page-hero {
		padding: 3rem 0 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.page-eyebrow {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.76rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--text-tertiary);
	}

	.page-title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 450;
		font-size: clamp(2.4rem, 5vw, 3.5rem);
		letter-spacing: -0.02em;
		line-height: 1.05;
		font-variation-settings:
			"opsz" 144,
			"SOFT" 30;
	}

	.page-lede {
		margin: 0.25rem 0 0;
		color: var(--text-secondary);
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1rem;
	}

	.publication-list {
		display: flex;
		flex-direction: column;
	}

	.publication-list :global(.publication-teaser.list:first-child) {
		border-top: none;
		padding-top: 0;
	}

	@media screen and (max-width: 640px) {
		.page-hero {
			padding: 1.5rem 0 1rem;
		}
	}
</style>
