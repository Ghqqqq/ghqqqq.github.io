---
import "../styles/article-list.css";
import "../styles/atlas-index.css";

import { getCollection } from "astro:content";
import { openGraph } from "homepage:globals";
import AtlasIndexHero from "../components/AtlasIndexHero.astro";
import PublicationTeaser from "../components/PublicationTeaser.astro";
import Layout from "../layouts/Layout.astro";

const publications = (await getCollection("publications")).sort(
	(a, b) =>
		b.data.year - a.data.year ||
		b.data.createdAt.getTime() - a.data.createdAt.getTime(),
);

const publicationYearGroups = publications.reduce(
	(groups, publication) => {
		const currentGroup = groups.at(-1);

		if (currentGroup?.year === publication.data.year) {
			currentGroup.publications.push(publication);
			return groups;
		}

		groups.push({
			year: publication.data.year,
			publications: [publication],
		});

		return groups;
	},
	[] as { year: number; publications: typeof publications }[],
);
---

<Layout
	title={openGraph.blog.title || "Full Publications"}
	description={openGraph.blog.description}
	layout="home"
	ambient="manuscript"
>
	<article class="atlas-index-page publication-index-page">
		<AtlasIndexHero
			eyebrow="Research archive"
			title="Publications"
			lede="A chronological index of work across reinforcement learning, bandits, recommendation, bidding, and multimodal systems."
			meta={`${publications.length} papers · ${publicationYearGroups.at(-1)?.year ?? ""}—${publicationYearGroups[0]?.year ?? ""}`}
		/>

		<div class="atlas-index-content">
			<div class="publication-archive full-publications-list">
			{
				publicationYearGroups.map((group) => (
					<section
						class="publication-year-group"
						aria-labelledby={`publications-${group.year}`}
					>
						<h2 class="publication-year-label" id={`publications-${group.year}`}>
							{group.year}
						</h2>
						<div class="publication-year-list">
							{group.publications.map((publication) => (
								<PublicationTeaser
									publication={publication}
									href={`/publications/${publication.id}`}
									variant="list"
								/>
							))}
						</div>
					</section>
				))
			}
			</div>
		</div>
	</article>
</Layout>

<style>
	.publication-archive {
		display: flex;
		flex-direction: column;
	}

	.publication-year-group {
		display: grid;
		grid-template-columns: minmax(5rem, 7rem) minmax(0, 1fr);
		column-gap: clamp(1.5rem, 4vw, 3.5rem);
		padding: 1.75rem 0 2.5rem;
		border-top: 1px solid color-mix(in srgb, var(--primary) 42%, transparent);
	}

	.publication-year-group:first-child {
		padding-top: 0;
		border-top: none;
	}

	.publication-year-label {
		position: sticky;
		top: 5rem;
		align-self: start;
		margin: 0.15rem 0 0;
		color: var(--primary-light);
		font-family: var(--font-mono);
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		line-height: 1;
	}

	.publication-year-list {
		display: flex;
		flex-direction: column;
	}

	.publication-year-list :global(.publication-teaser.list:first-child) {
		border-top: none;
		padding-top: 0;
	}

	.publication-archive :global(.publication-teaser.list) {
		position: relative;
		gap: 0.36rem;
		padding: 1.2rem 0;
		transition:
			border-color 0.18s ease,
			color 0.18s ease;
	}

	.publication-archive :global(.publication-teaser.list::before) {
		content: "";
		position: absolute;
		top: 1.35rem;
		left: -0.7rem;
		width: 1px;
		height: 1.25rem;
		background-color: transparent;
		transition: background-color 0.18s ease;
	}

	.publication-archive :global(.publication-teaser.list:has(.publication-main-link:hover)),
	.publication-archive :global(.publication-teaser.list:has(.publication-main-link:focus-visible)) {
		background-color: transparent;
		border-top-color: var(--hairline);
	}

	.publication-archive
		:global(.publication-teaser.list:has(.publication-main-link:hover)::before),
	.publication-archive
		:global(.publication-teaser.list:has(.publication-main-link:focus-visible)::before) {
		background-color: var(--primary-light);
	}

	.publication-archive :global(.publication-teaser.list .publication-copy) {
		gap: 0.38rem;
	}

	.publication-archive :global(.publication-teaser.list .publication-copy h3) {
		font-size: 1.16rem;
		line-height: 1.28;
	}

	.publication-archive :global(.publication-teaser.list .publication-authors) {
		font-size: 0.88rem;
	}

	.publication-archive :global(.publication-teaser.list .publication-meta) {
		font-size: 0.82rem;
		color: var(--text-tertiary);
	}

	@media screen and (max-width: 640px) {
		.publication-year-group {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 0.85rem;
			padding: 1.25rem 0 2rem;
		}

		.publication-year-label {
			position: static;
			margin: 0;
		}

		.publication-archive :global(.publication-teaser.list) {
			padding: 1rem 0;
		}

		.publication-archive :global(.publication-teaser.list::before) {
			left: -0.55rem;
			top: 1.15rem;
			height: 1.1rem;
		}

		.publication-archive :global(.publication-teaser.list .post-header) {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: start;
			column-gap: 0.75rem;
		}

		.publication-archive :global(.publication-teaser.list .post-date) {
			padding-top: 0.12rem;
		}
	}
</style>
