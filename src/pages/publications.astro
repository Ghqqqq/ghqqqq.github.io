---
import "../styles/article-list.css";

import { getCollection } from "astro:content";
import { openGraph } from "homepage:globals";
import PublicationTeaser from "../components/PublicationTeaser.astro";
import Layout from "../layouts/Layout.astro";

const publications = (await getCollection("publications")).sort(
	(a, b) =>
		b.data.year - a.data.year ||
		b.data.createdAt.getTime() - a.data.createdAt.getTime(),
);

const publicationYearGroups = publications.reduce(
	(groups, publication) => {
		const currentGroup = groups.at(-1);

		if (currentGroup?.year === publication.data.year) {
			currentGroup.publications.push(publication);
			return groups;
		}

		groups.push({
			year: publication.data.year,
			publications: [publication],
		});

		return groups;
	},
	[] as { year: number; publications: typeof publications }[],
);
---

<Layout
	title={openGraph.blog.title || "Full Publications"}
	description={openGraph.blog.description}
	layout="single"
>
	<article class="page-index">
		<header class="page-hero">
			<p class="page-eyebrow">Index</p>
			<h1 class="page-title">Publications</h1>
			<p class="page-lede">
				{publications.length} paper{publications.length === 1 ? "" : "s"}, sorted by year.
			</p>
		</header>

		<hr class="hairline" />

		<div class="publication-archive full-publications-list">
			{
				publicationYearGroups.map((group) => (
					<section
						class="publication-year-group"
						aria-labelledby={`publications-${group.year}`}
					>
						<h2 class="publication-year-label" id={`publications-${group.year}`}>
							{group.year}
						</h2>
						<div class="publication-year-list">
							{group.publications.map((publication) => (
								<PublicationTeaser
									publication={publication}
									href={`/publications/${publication.id}`}
									variant="list"
								/>
							))}
						</div>
					</section>
				))
			}
		</div>
	</article>
</Layout>

<style>
	.page-index {
		width: 100%;
	}

	.page-hero {
		padding: 2.25rem 0 1.1rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 0.55rem 1.5rem;
	}

	.page-eyebrow {
		grid-column: 1 / -1;
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.76rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--text-tertiary);
	}

	.page-title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 450;
		font-size: clamp(2.4rem, 5vw, 3.5rem);
		letter-spacing: -0.02em;
		line-height: 1.05;
		font-variation-settings:
			"opsz" 144,
			"SOFT" 30;
	}

	.page-lede {
		margin: 0 0 0.25rem;
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-style: normal;
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.publication-archive {
		display: flex;
		flex-direction: column;
	}

	.publication-year-group {
		display: grid;
		grid-template-columns: minmax(4.75rem, 6rem) minmax(0, 1fr);
		column-gap: 1.35rem;
		padding-top: 1.2rem;
		border-top: 1px solid var(--hairline);
	}

	.publication-year-group:first-child {
		padding-top: 0;
		border-top: none;
	}

	.publication-year-label {
		position: sticky;
		top: 5rem;
		align-self: start;
		margin: 0.15rem 0 0;
		color: var(--text-tertiary);
		font-family: var(--font-mono);
		font-size: 0.88rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		line-height: 1;
	}

	.publication-year-list {
		display: flex;
		flex-direction: column;
	}

	.publication-year-list :global(.publication-teaser.list:first-child) {
		border-top: none;
		padding-top: 0;
	}

	.publication-archive :global(.publication-teaser.list) {
		position: relative;
		gap: 0.36rem;
		padding: 1.2rem 0;
		transition:
			border-color 0.18s ease,
			color 0.18s ease;
	}

	.publication-archive :global(.publication-teaser.list::before) {
		content: "";
		position: absolute;
		top: 1.35rem;
		left: -0.7rem;
		width: 1px;
		height: 1.25rem;
		background-color: transparent;
		transition: background-color 0.18s ease;
	}

	.publication-archive :global(.publication-teaser.list:has(.publication-main-link:hover)),
	.publication-archive :global(.publication-teaser.list:has(.publication-main-link:focus-visible)) {
		background-color: transparent;
		border-top-color: var(--hairline);
	}

	.publication-archive
		:global(.publication-teaser.list:has(.publication-main-link:hover)::before),
	.publication-archive
		:global(.publication-teaser.list:has(.publication-main-link:focus-visible)::before) {
		background-color: rgba(var(--primary-rgb), 0.74);
	}

	.publication-archive :global(.publication-teaser.list .publication-copy) {
		gap: 0.38rem;
	}

	.publication-archive :global(.publication-teaser.list .publication-copy h3) {
		font-size: 1.16rem;
		line-height: 1.28;
	}

	.publication-archive :global(.publication-teaser.list .publication-authors) {
		font-size: 0.88rem;
	}

	.publication-archive :global(.publication-teaser.list .publication-meta) {
		font-size: 0.82rem;
		color: var(--text-tertiary);
	}

	@media screen and (max-width: 640px) {
		.page-hero {
			grid-template-columns: minmax(0, 1fr);
			align-items: start;
			padding: 1.5rem 0 1rem;
			gap: 0.45rem;
		}

		.page-lede {
			margin: 0.1rem 0 0;
			white-space: normal;
		}

		.publication-year-group {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 0.85rem;
			padding-top: 1.25rem;
		}

		.publication-year-label {
			position: static;
			margin: 0;
		}

		.publication-archive :global(.publication-teaser.list) {
			padding: 1rem 0;
		}

		.publication-archive :global(.publication-teaser.list::before) {
			left: -0.55rem;
			top: 1.15rem;
			height: 1.1rem;
		}

		.publication-archive :global(.publication-teaser.list .post-header) {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: start;
			column-gap: 0.75rem;
		}

		.publication-archive :global(.publication-teaser.list .post-date) {
			padding-top: 0.12rem;
		}
	}
</style>
