---
interface Props {
	context: "overview" | "research";
}
const { context } = Astro.props;
---

<div class:list={["atlas-surface-controls", "atlas-surface-controls--" + context]} role="group" aria-label={context === "overview" ? "Overview surface rendering" : "Research surface rendering"}>
  <span>Surface</span>
  <button type="button" data-surface-mode="relief" aria-pressed="true" aria-label="Satin relief" title="Satin relief" disabled><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>Relief</button>
  <button type="button" data-surface-mode="contours" aria-pressed="false" aria-label="Contour study" title="Contour study" disabled><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m12 3 9 5-9 5-9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5"/></svg>Contours</button>
</div>
