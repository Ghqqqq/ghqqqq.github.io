---
import { liteAdaptor } from "mathjax-full/js/adaptors/liteAdaptor.js";
import { RegisterHTMLHandler } from "mathjax-full/js/handlers/html.js";
import { AllPackages } from "mathjax-full/js/input/tex/AllPackages.js";
import { TeX } from "mathjax-full/js/input/tex.js";
import { mathjax } from "mathjax-full/js/mathjax.js";
import { SVG } from "mathjax-full/js/output/svg.js";

const adaptor = liteAdaptor();
RegisterHTMLHandler(adaptor);
const mjDocument = mathjax.document("", {
	InputJax: new TeX({ packages: AllPackages }),
	OutputJax: new SVG({ fontCache: "local" }),
});

const formulas = [
	{
		tex: String.raw`Q^{*}(s,a) = r(s,a) + \gamma\,\mathbb{E}_{s'}\!\left[\max_{a'} Q^{*}(s',a')\right]`,
		className: "atlas-formula--upper-left atlas-formula--peripheral",
		duration: 38,
		delay: -11,
		size: 0.94,
	},
	{
		tex: String.raw`R(T) \le \mathcal{O}\!\left(\sqrt{KT\log T}\right)`,
		className: "atlas-formula--lower-left",
		duration: 32,
		delay: -23,
		size: 1.06,
	},
	{
		tex: String.raw`\nabla_{\theta}J(\theta) = \mathbb{E}_{\pi_{\theta}}\!\left[\nabla_{\theta}\log\pi_{\theta}(a|s)\,Q^{\pi}(s,a)\right]`,
		className: "atlas-formula--upper-right atlas-formula--peripheral",
		duration: 44,
		delay: -31,
		size: 0.82,
	},
	{
		tex: String.raw`x_{t+1} = \Pi_{\mathcal{X}}\!\left(x_t - \eta\,\nabla f_t(x_t)\right)`,
		className: "atlas-formula--mid-right",
		duration: 36,
		delay: -7,
		size: 0.9,
	},
	{
		tex: String.raw`\mathrm{Reg}(T) \le \frac{D^{2}}{2\eta} + \frac{\eta G^{2}T}{2}`,
		className: "atlas-formula--lower-mid",
		duration: 41,
		delay: -18,
		size: 0.88,
	},
].map((formula) => ({
	...formula,
	html: adaptor.innerHTML(mjDocument.convert(formula.tex, { display: true })),
}));
---

<div class="atlas-formula-field" aria-hidden="true">
	{
		formulas.map((formula) => (
			<div
				class:list={["atlas-formula", formula.className]}
				style={`--formula-duration: ${formula.duration}s; --formula-delay: ${formula.delay}s; --formula-size: ${formula.size}rem;`}
				set:html={formula.html}
			/>
		))
	}
</div>

<style>
	.atlas-formula-field {
		position: absolute;
		inset: 0;
		z-index: 1;
		overflow: hidden;
		color: rgba(255, 255, 255, 0.12);
		pointer-events: none;
		user-select: none;
	}

	.atlas-formula {
		position: absolute;
		font-size: var(--formula-size);
		line-height: 1;
		white-space: nowrap;
		opacity: 0;
		animation: atlas-formula-drift var(--formula-duration) linear infinite;
		animation-delay: var(--formula-delay);
	}

	.atlas-formula :global(mjx-container) {
		margin: 0;
	}

	.atlas-formula :global(svg) {
		display: block;
		max-width: min(32rem, 36vw);
		height: auto;
	}

	.atlas-formula--upper-left {
		top: 20%;
		left: 2.5%;
	}

	.atlas-formula--lower-left {
		top: 68%;
		left: 5%;
	}

	.atlas-formula--upper-right {
		top: 13%;
		right: 2.5%;
	}

	.atlas-formula--mid-right {
		top: 56%;
		right: 3%;
	}

	.atlas-formula--lower-mid {
		left: 29%;
		bottom: 8%;
	}

	@keyframes atlas-formula-drift {
		0%,
		100% {
			opacity: 0;
			transform: translate3d(0, 14px, 0);
		}
		18%,
		62% {
			opacity: 0.72;
		}
		82% {
			opacity: 0;
			transform: translate3d(0, -18px, 0);
		}
	}

	@media screen and (max-width: 1260px) {
		.atlas-formula--peripheral {
			display: none;
		}

		.atlas-formula-field {
			color: rgba(255, 255, 255, 0.09);
		}

		.atlas-formula--lower-left {
			left: 3%;
		}

		.atlas-formula--lower-mid {
			left: 18%;
		}
	}

	@media screen and (max-width: 860px) {
		.atlas-formula-field {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.atlas-formula {
			animation: none;
			opacity: 0.42;
			transform: none;
		}
	}
</style>
