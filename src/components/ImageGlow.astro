---
import type { LocalImageProps, RemoteImageProps } from "astro:assets";
import { Image } from "astro:assets";

// `parallax` is accepted for API compatibility but no longer rendered.
type Props = (LocalImageProps | RemoteImageProps) & {
	parallax?: boolean;
};

const { parallax: _parallax, ...props } = Astro.props as Props;
---

<div class="plain-image">
  <Image {...props} />
</div>
<style>
  .plain-image {
    position: relative;
    display: block;
  }

  .plain-image :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
