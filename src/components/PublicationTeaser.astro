---
import type { CollectionEntry } from "astro:content";

interface Props {
	publication: CollectionEntry<"publications">;
	href: string;
	variant?: "compact" | "full" | "list";
	showLineage?: boolean;
}

const {
	publication,
	href,
	variant = "compact",
	showLineage = false,
} = Astro.props;
const isExternal = href.startsWith("http://") || href.startsWith("https://");
const venueLabel =
	(publication.data.venueShort ??
		publication.data.venue
			.split(/\s+/)
			.map((part) =>
				part
					.replace(/[^A-Za-z0-9]/g, "")
					.slice(0, 1)
					.toUpperCase(),
			)
			.join("")
			.slice(0, 8)) ||
	"PAPER";
const statusLabel =
	publication.data.status === "journal"
		? "Journal"
		: publication.data.status === "submitted"
			? "Submitted"
			: publication.data.status === "preprint"
				? "ArXiv"
				: publication.data.status === "conference"
					? "Published"
					: undefined;
const hasEqualContribution = publication.data.authors.includes("*");
const lineage = showLineage ? publication.data.lineage : undefined;
const lineageSourceHref = lineage
	? `/publications/${lineage.sourceId}`
	: undefined;
---

<article
	class:list={["publication-teaser", variant]}
>
	{
		variant !== "list" && (
			<a
				href={href}
				class="publication-cover-link"
				target={isExternal ? "_blank" : undefined}
				rel={isExternal ? "noopener noreferrer" : undefined}
				aria-label={publication.data.title}
			>
				<div class="publication-cover" aria-hidden="true">
					<span class="publication-badge">{venueLabel}</span>
					<strong>{publication.data.year}</strong>
				</div>
			</a>
		)
	}
	<div class="publication-copy">
		<a
			href={href}
			class="publication-main-link"
			target={isExternal ? "_blank" : undefined}
			rel={isExternal ? "noopener noreferrer" : undefined}
		>
			<div class="post-header">
				<h3>{publication.data.title}</h3>
				<span class="post-date">{publication.data.year}</span>
			</div>
		</a>
		<p class="publication-authors">{publication.data.authors}</p>
		{hasEqualContribution && (
			<p class="publication-author-note">* equal contribution</p>
		)}
		<div class="publication-meta-row">
			<p class="publication-meta">{publication.data.venue}</p>
			{variant === "full" && statusLabel && (
				<span class="publication-status">{statusLabel}</span>
			)}
		</div>
		{
			lineage && lineageSourceHref && (
				<div class="publication-lineage">
					<span class="publication-lineage-label">{lineage.label}</span>
					<p class="publication-lineage-text">{lineage.text}</p>
					<p class="publication-lineage-source-line">
						<span>Stems from </span>
						<a href={lineageSourceHref} class="publication-lineage-source">
							{lineage.sourceTitle}
						</a>
					</p>
				</div>
			)
		}
	</div>
</article>

<style>
	.publication-teaser {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr);
		gap: 1.25rem;
		padding: 1.1rem 0;
		border-top: 1px solid var(--hairline);
		color: var(--text-primary);
		text-decoration: none;
		transition:
			background-color 0.18s ease,
			border-color 0.18s ease,
			color 0.18s ease;
	}

	.publication-teaser:has(.publication-main-link:hover),
	.publication-teaser:has(.publication-main-link:focus-visible),
	.publication-teaser:has(.publication-cover-link:hover),
	.publication-teaser:has(.publication-cover-link:focus-visible) {
		background-color: rgba(var(--primary-rgb), 0.025);
		border-top-color: rgba(var(--primary-rgb), 0.24);
	}

	.publication-main-link,
	.publication-cover-link {
		color: inherit;
		text-decoration: none;
	}

	.publication-main-link:focus-visible,
	.publication-cover-link:focus-visible,
	.publication-lineage-source:focus-visible {
		outline: 1px solid rgba(var(--primary-rgb), 0.75);
		outline-offset: 3px;
	}

	.publication-main-link:hover h3,
	.publication-main-link:focus-visible h3,
	.publication-teaser:has(.publication-cover-link:hover) h3,
	.publication-teaser:has(.publication-cover-link:focus-visible) h3 {
		color: var(--primary);
	}

	.publication-main-link:hover .post-date,
	.publication-main-link:focus-visible .post-date,
	.publication-teaser:has(.publication-cover-link:hover) .post-date,
	.publication-teaser:has(.publication-cover-link:focus-visible) .post-date {
		color: var(--primary);
	}

	.publication-teaser .post-date {
		transition: color 0.18s ease;
	}

	.publication-cover-link {
		display: block;
	}

	.publication-cover {
		aspect-ratio: 3 / 4;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 0.6rem 0.55rem;
		background: transparent;
		border: 1px solid var(--border-color);
		transition: border-color 0.18s ease;
	}

	.publication-teaser:has(.publication-cover-link:hover) .publication-cover,
	.publication-teaser:has(.publication-cover-link:focus-visible) .publication-cover {
		border-color: rgba(var(--primary-rgb), 0.44);
	}

	.publication-badge {
		display: inline-flex;
		width: fit-content;
		padding: 0.1rem 0.35rem;
		background: transparent;
		border: 1px solid var(--border-color);
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.publication-cover strong {
		font-family: var(--font-mono);
		font-size: 1.1rem;
		font-weight: 500;
		line-height: 1;
		color: var(--text-secondary);
	}

	.publication-copy {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.publication-copy h3 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 1.18rem;
		line-height: 1.3;
		letter-spacing: -0.005em;
		color: var(--text-primary);
		transition: color 0.15s ease;
	}

	.publication-authors,
	.publication-meta {
		margin: 0;
		color: var(--text-secondary);
		line-height: 1.5;
	}

	.publication-author-note {
		margin: -0.15rem 0 0;
		color: var(--text-tertiary);
		font-family: var(--font-mono);
		font-size: 0.76rem;
		letter-spacing: 0.03em;
	}

	.publication-authors {
		font-size: 0.94rem;
	}

	.publication-meta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: flex-start;
		gap: 0.4rem 0.75rem;
	}

	.publication-meta {
		font-size: 0.88rem;
	}

	.publication-status {
		display: inline-flex;
		align-items: center;
		padding: 0;
		border: none;
		background: transparent;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-tertiary);
	}

	.publication-status::before {
		content: "·";
		margin-right: 0.5rem;
		color: var(--text-tertiary);
	}

	.publication-lineage {
		margin-top: 0.1rem;
		padding: 0.18rem 0 0.05rem 0.75rem;
		border-left: 1px solid var(--hairline);
		display: grid;
		gap: 0.16rem;
	}

	.publication-lineage-label {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-tertiary);
	}

	.publication-lineage-text,
	.publication-lineage-source-line {
		margin: 0;
		line-height: 1.4;
	}

	.publication-lineage-text {
		color: var(--text-secondary);
		font-family: var(--font-display);
		font-size: 0.92rem;
	}

	.publication-lineage-source-line {
		color: var(--text-tertiary);
		font-size: 0.82rem;
	}

	.publication-lineage-source {
		color: var(--text-secondary);
		background-image: linear-gradient(var(--primary), var(--primary));
		background-position: 0 100%;
		background-repeat: no-repeat;
		background-size: 0% 1px;
		text-decoration: none;
		transition:
			background-size 0.18s ease,
			color 0.15s ease;
	}

	.publication-lineage-source:hover,
	.publication-lineage-source:focus-visible {
		color: var(--primary);
		background-size: 100% 1px;
	}

	.publication-teaser.compact {
		grid-template-columns: 5rem minmax(0, 1fr);
	}

	.publication-teaser.compact .publication-cover {
		padding: 0.65rem;
	}

	.publication-teaser.full {
		grid-template-columns: 6rem minmax(0, 1fr);
	}

	.publication-teaser.list {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 1rem 0;
	}

	.publication-teaser.list .publication-copy {
		gap: 0.3rem;
	}

	.publication-teaser.list .publication-copy h3 {
		font-size: 1.08rem;
	}

	.publication-teaser.list .publication-authors {
		font-size: 0.9rem;
	}

	.publication-teaser.list .publication-author-note {
		font-size: 0.72rem;
	}

	.publication-teaser.list .publication-meta-row {
		justify-content: flex-start;
		gap: 0.35rem 0.75rem;
	}

	.publication-teaser.list .publication-meta {
		font-size: 0.86rem;
	}

	.publication-teaser.list .publication-status {
		margin-left: 0;
	}

	@media screen and (max-width: 640px) {
		.publication-teaser,
		.publication-teaser.compact,
		.publication-teaser.full {
			grid-template-columns: 4.25rem minmax(0, 1fr);
			gap: 0.85rem;
			padding: 0.9rem;
		}

		.publication-cover strong {
			font-size: 1.15rem;
		}

		.publication-teaser.list {
			padding: 0.8rem 0.9rem;
		}

		.publication-teaser.list .publication-status {
			margin-left: 0;
		}
	}
</style>
