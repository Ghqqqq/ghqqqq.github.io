---
import type { CollectionEntry } from "astro:content";

interface Props {
	publication: CollectionEntry<"publications">;
	href: string;
	variant?: "compact" | "full" | "list";
}

const { publication, href, variant = "compact" } = Astro.props;
const isExternal = href.startsWith("http://") || href.startsWith("https://");
const venueLabel =
	(publication.data.venueShort ??
		publication.data.venue
			.split(/\s+/)
			.map((part) =>
				part
					.replace(/[^A-Za-z0-9]/g, "")
					.slice(0, 1)
					.toUpperCase(),
			)
			.join("")
			.slice(0, 8)) ||
	"PAPER";
const statusLabel =
	publication.data.status === "journal"
		? "Journal"
		: publication.data.status === "submitted"
			? "Submitted"
			: publication.data.status === "preprint"
				? "ArXiv"
				: publication.data.status === "conference"
					? "Published"
					: undefined;
const hasEqualContribution = publication.data.authors.includes("*");
---

<a
	href={href}
	class:list={["publication-teaser", variant]}
	target={isExternal ? "_blank" : undefined}
	rel={isExternal ? "noopener noreferrer" : undefined}
>
	{
		variant !== "list" && (
			<div class="publication-cover" aria-hidden="true">
				<span class="publication-badge">{venueLabel}</span>
				<strong>{publication.data.year}</strong>
			</div>
		)
	}
	<div class="publication-copy">
		<div class="post-header">
			<h3>{publication.data.title}</h3>
			<span class="post-date">{publication.data.year}</span>
		</div>
		<p class="publication-authors">{publication.data.authors}</p>
		{hasEqualContribution && (
			<p class="publication-author-note">* equal contribution</p>
		)}
		<div class="publication-meta-row">
			<p class="publication-meta">{publication.data.venue}</p>
			{variant === "full" && statusLabel && (
				<span class="publication-status">{statusLabel}</span>
			)}
		</div>
	</div>
</a>

<style>
	.publication-teaser {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr);
		gap: 1.25rem;
		padding: 1.1rem 0;
		border-top: 1px solid var(--hairline);
		color: var(--text-primary);
		text-decoration: none;
		transition:
			color 0.15s ease,
			transform 0.18s ease 40ms;
	}

	.publication-teaser:hover,
	.publication-teaser:focus-visible {
		color: var(--primary);
		transform: translateX(2px);
		transition-delay: 0ms;
		outline: none;
	}

	.publication-teaser:hover h3,
	.publication-teaser:focus-visible h3 {
		color: var(--primary);
	}

	.publication-cover {
		aspect-ratio: 3 / 4;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 0.6rem 0.55rem;
		background: transparent;
		border: 1px solid var(--border-color);
	}

	.publication-badge {
		display: inline-flex;
		width: fit-content;
		padding: 0.1rem 0.35rem;
		background: transparent;
		border: 1px solid var(--border-color);
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.publication-cover strong {
		font-family: var(--font-mono);
		font-size: 1.1rem;
		font-weight: 500;
		line-height: 1;
		color: var(--text-secondary);
	}

	.publication-copy {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.publication-copy h3 {
		margin: 0;
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 500;
		font-size: 1.18rem;
		line-height: 1.3;
		letter-spacing: -0.005em;
		color: var(--text-primary);
		transition: color 0.15s ease;
	}

	.publication-authors,
	.publication-meta {
		margin: 0;
		color: var(--text-secondary);
		line-height: 1.5;
	}

	.publication-author-note {
		margin: -0.15rem 0 0;
		color: var(--text-tertiary);
		font-family: var(--font-mono);
		font-size: 0.76rem;
		letter-spacing: 0.03em;
	}

	.publication-authors {
		font-size: 0.94rem;
	}

	.publication-meta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: flex-start;
		gap: 0.4rem 0.75rem;
	}

	.publication-meta {
		font-size: 0.88rem;
		font-style: italic;
	}

	.publication-status {
		display: inline-flex;
		align-items: center;
		padding: 0;
		border: none;
		background: transparent;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-tertiary);
	}

	.publication-status::before {
		content: "·";
		margin-right: 0.5rem;
		color: var(--text-tertiary);
	}

	.publication-teaser.compact {
		grid-template-columns: 5rem minmax(0, 1fr);
	}

	.publication-teaser.compact .publication-cover {
		padding: 0.65rem;
	}

	.publication-teaser.full {
		grid-template-columns: 6rem minmax(0, 1fr);
	}

	.publication-teaser.list {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 1rem 0;
	}

	.publication-teaser.list .publication-copy {
		gap: 0.3rem;
	}

	.publication-teaser.list .publication-copy h3 {
		font-size: 1.08rem;
	}

	.publication-teaser.list .publication-authors {
		font-size: 0.9rem;
	}

	.publication-teaser.list .publication-author-note {
		font-size: 0.72rem;
	}

	.publication-teaser.list .publication-meta-row {
		justify-content: flex-start;
		gap: 0.35rem 0.75rem;
	}

	.publication-teaser.list .publication-meta {
		font-size: 0.86rem;
	}

	.publication-teaser.list .publication-status {
		margin-left: 0;
	}

	@media screen and (max-width: 640px) {
		.publication-teaser,
		.publication-teaser.compact,
		.publication-teaser.full {
			grid-template-columns: 4.25rem minmax(0, 1fr);
			gap: 0.85rem;
			padding: 0.9rem;
		}

		.publication-cover strong {
			font-size: 1.15rem;
		}

		.publication-teaser.list {
			padding: 0.8rem 0.9rem;
		}

		.publication-teaser.list .publication-status {
			margin-left: 0;
		}
	}
</style>
