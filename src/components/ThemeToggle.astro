---
---

<button id="theme-toggle" type="button" aria-label="Toggle color theme" aria-pressed="true">
	<span class="theme-toggle-glyph" aria-hidden="true">
		<svg class="theme-toggle-svg" viewBox="0 0 24 24" width="16" height="16">
			<circle class="theme-toggle-disc" cx="12" cy="12" r="4" />
			<path
				class="theme-toggle-rays"
				d="M12 3v2.2M12 18.8V21M3 12h2.2M18.8 12H21M5.64 5.64l1.56 1.56M16.8 16.8l1.56 1.56M18.36 5.64 16.8 7.2M7.2 16.8l-1.56 1.56"
			/>
			<path
				class="theme-toggle-moon-body"
				d="M18.6 14.25A6.8 6.8 0 0 1 9.75 5.4 7.2 7.2 0 1 0 18.6 14.25Z"
			/>
		</svg>
	</span>
	<span class="theme-toggle-label">Dark</span>
</button>

<script is:inline>
	(() => {
		const storageKey = "homepage-theme";
		const button = document.querySelector("#theme-toggle");
		const label = button?.querySelector(".theme-toggle-label");
		const themeMeta = document.querySelector('meta[name="theme-color"]');

		const applyTheme = (theme) => {
			document.documentElement.dataset.theme = theme;
			document.documentElement.style.colorScheme = theme;
			button?.setAttribute("aria-pressed", String(theme === "dark"));
			if (label) {
				label.textContent = theme === "dark" ? "Dark" : "Light";
			}
			if (themeMeta) {
				const isAtlasHome = document.body.classList.contains("page-home");
				themeMeta.setAttribute(
					"content",
					isAtlasHome ? "#1735d6" : theme === "dark" ? "#15130f" : "#f4efe4",
				);
			}
			window.dispatchEvent(
				new CustomEvent("homepage-theme-change", {
					detail: { theme },
				}),
			);
		};

		const syncTheme = () => {
			const storedTheme = localStorage.getItem(storageKey);
			applyTheme(storedTheme === "light" ? "light" : "dark");
		};

		syncTheme();

		button?.addEventListener("click", () => {
			const nextTheme =
				document.documentElement.dataset.theme === "dark" ? "light" : "dark";
			localStorage.setItem(storageKey, nextTheme);
			applyTheme(nextTheme);
		});
	})();
</script>

<style>
	#theme-toggle {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 1px solid transparent;
		border-radius: 999px;
		background: transparent;
		color: var(--text-secondary);
		cursor: pointer;
		transition:
			border-color 0.18s ease,
			background-color 0.18s ease,
			color 0.18s ease;
	}

	#theme-toggle:hover,
	#theme-toggle:focus-visible {
		color: var(--text-primary);
		border-color: var(--border-color);
		background-color: rgba(var(--primary-rgb), 0.05);
		outline: none;
	}

	.theme-toggle-glyph {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1rem;
		height: 1rem;
	}

	.theme-toggle-svg {
		display: block;
		width: 1rem;
		height: 1rem;
		overflow: visible;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.theme-toggle-disc,
	.theme-toggle-rays,
	.theme-toggle-moon-body {
		transform-box: fill-box;
		transform-origin: center;
		transition:
			opacity 0.22s ease,
			stroke-dashoffset 0.28s ease,
			transform 0.28s ease;
	}

	.theme-toggle-rays {
		stroke-dasharray: 26;
		stroke-dashoffset: 0;
	}

	.theme-toggle-moon-body {
		opacity: 0;
		stroke-dasharray: 40;
		stroke-dashoffset: 40;
		transform: scale(0.72) rotate(-12deg);
	}

	:global(html[data-theme="dark"]) .theme-toggle-disc {
		opacity: 0;
		transform: scale(0.5);
	}

	:global(html[data-theme="dark"]) .theme-toggle-rays {
		opacity: 0;
		stroke-dashoffset: 26;
		transform: rotate(18deg) scale(0.86);
	}

	:global(html[data-theme="dark"]) .theme-toggle-moon-body {
		opacity: 1;
		stroke-dashoffset: 0;
		transform: scale(1) rotate(0deg);
	}

	.theme-toggle-label {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}
</style>
