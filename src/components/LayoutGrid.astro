---
interface Props {
	variant?: "split" | "single" | "home";
}

const { variant = "split" } = Astro.props;
---

{variant === "split" ? (
  <div class="layout-grid">
    <slot name="left" />
    <slot name="right" />
  </div>
) : (
  <div class:list={[variant === "single" ? "layout-single" : "layout-home"]}>
    <slot />
  </div>
)}

<style>
  .layout-grid {
    position: relative;
    align-items: start;
    align-content: stretch;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 2fr 5fr;
    grid-template-rows: auto;
  }

  .layout-single {
    position: relative;
    width: 100%;
  }

  .layout-home {
    position: relative;
    width: 100%;
  }

  @media screen and (max-width: 1380px) {
    .layout-grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 640px) {
    .layout-grid {
      margin: 0 1rem;
      gap: 1.5rem;
    }

    .layout-single {
      width: calc(100% - 2rem);
      margin: 0 1rem;
    }
  }
</style>
