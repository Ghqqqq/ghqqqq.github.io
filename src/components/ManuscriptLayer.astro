---
/**
 * Manuscript layer: the page is printed over a sheet of working math.
 * TeX sources are compiled to SVG at build time via MathJax (mathjax-full) —
 * zero runtime JS, zero webfont downloads, fill follows currentColor so the
 * layer themes with the palette. The content column (opaque main) occludes
 * the middle, so the gutters carry the derivations: two sheets of paper.
 *
 * Content is textbook RL / bandits canon (Sutton–Barto, Lattimore–
 * Szepesvári), deliberately not lifted from the site owner's own papers.
 */
import { liteAdaptor } from "mathjax-full/js/adaptors/liteAdaptor.js";
import { RegisterHTMLHandler } from "mathjax-full/js/handlers/html.js";
import { AllPackages } from "mathjax-full/js/input/tex/AllPackages.js";
import { TeX } from "mathjax-full/js/input/tex.js";
import { mathjax } from "mathjax-full/js/mathjax.js";
import { SVG } from "mathjax-full/js/output/svg.js";

const adaptor = liteAdaptor();
RegisterHTMLHandler(adaptor);
const svgOutput = new SVG({ fontCache: "global" });
const mjDocument = mathjax.document("", {
	InputJax: new TeX({ packages: AllPackages }),
	OutputJax: svgOutput,
});

const typeset = (tex: string) =>
	adaptor.innerHTML(mjDocument.convert(tex, { display: true }));

const formulas = [
	// Returns, values, Bellman
	String.raw`G_t = \sum_{k=0}^{\infty} \gamma^{k}\, r_{t+k+1}`,
	String.raw`V^{\pi}(s) = \mathbb{E}_{\pi}\big[\, G_t \mid s_t = s \,\big]`,
	String.raw`V^{\pi}(s) = \sum_{a}\pi(a|s)\sum_{s'} P(s'|s,a)\big[r + \gamma V^{\pi}(s')\big]`,
	String.raw`V^{*}(s) = \max_{a}\Big[ r(s,a) + \gamma \sum_{s'} P(s'|s,a)\, V^{*}(s') \Big]`,
	String.raw`Q^{*}(s,a) = r(s,a) + \gamma\,\mathbb{E}_{s'}\big[\max_{a'} Q^{*}(s',a')\big]`,
	String.raw`A^{\pi}(s,a) = Q^{\pi}(s,a) - V^{\pi}(s)`,
	String.raw`\|\mathcal{T}V - \mathcal{T}V'\|_{\infty} \le \gamma\, \|V - V'\|_{\infty}`,
	String.raw`\|V_{k} - V^{*}\|_{\infty} \le \gamma^{k}\, \|V_{0} - V^{*}\|_{\infty}`,
	String.raw`d^{\pi}(s) = (1-\gamma)\sum_{t=0}^{\infty}\gamma^{t}\,\mathbb{P}(s_t = s)`,
	// TD / tabular control
	String.raw`\delta_t = r_{t+1} + \gamma V(s_{t+1}) - V(s_t)`,
	String.raw`Q(s,a) \leftarrow Q(s,a) + \alpha\big[ r + \gamma \max_{a'} Q(s',a') - Q(s,a) \big]`,
	String.raw`Q(s,a) \leftarrow Q(s,a) + \alpha\big[ r + \gamma\, Q(s',a') - Q(s,a) \big]`,
	String.raw`e_t(s) = \gamma\lambda\, e_{t-1}(s) + \mathbf{1}\{s_t = s\}`,
	String.raw`y_t = r_t + \gamma \max_{a'} Q(s_{t+1}, a';\, \theta^{-})`,
	String.raw`\sum_{t} \alpha_t = \infty, \qquad \sum_{t} \alpha_t^{2} < \infty`,
	// Policy gradient family
	String.raw`\nabla_{\theta} J(\theta) = \mathbb{E}_{\pi_\theta}\big[\nabla_{\theta}\log \pi_{\theta}(a|s)\; Q^{\pi}(s,a)\big]`,
	String.raw`\nabla_{\theta} J = \mathbb{E}\Big[\sum_{t}\nabla_{\theta}\log\pi_{\theta}(a_t|s_t)\,\big(G_t - b(s_t)\big)\Big]`,
	String.raw`\hat{A}_t = \sum_{l=0}^{\infty} (\gamma\lambda)^{l}\, \delta_{t+l}`,
	String.raw`\rho_t = \frac{\pi_{\theta}(a_t|s_t)}{\pi_{\mathrm{old}}(a_t|s_t)}`,
	String.raw`L(\theta) = \mathbb{E}\big[\min\big(\rho_t \hat{A}_t,\; \mathrm{clip}(\rho_t, 1-\epsilon, 1+\epsilon)\, \hat{A}_t\big)\big]`,
	String.raw`\theta \leftarrow \theta + \alpha\, \delta_t\, \nabla_{\theta} \log \pi_{\theta}(a_t|s_t)`,
	String.raw`J(\pi') - J(\pi) = \tfrac{1}{1-\gamma}\, \mathbb{E}_{s\sim d^{\pi'}}\big[ A^{\pi}(s,a) \big]`,
	String.raw`\pi^{*}(a|s) \propto \exp\big( Q(s,a) / \alpha \big)`,
	String.raw`V(s) = \alpha \log \sum_{a} \exp\big( Q(s,a)/\alpha \big)`,
	String.raw`\mathcal{H}(\pi(\cdot|s)) = -\sum_{a} \pi(a|s)\log \pi(a|s)`,
	// Bandits
	String.raw`a_t = \arg\max_{i}\Big[\,\hat{\mu}_i(t) + \sqrt{\tfrac{2\log t}{N_i(t)}}\,\Big]`,
	String.raw`R(T) = T\mu^{*} - \mathbb{E}\Big[\sum_{t=1}^{T} r_t\Big]`,
	String.raw`\Delta_i = \mu^{*} - \mu_i`,
	String.raw`\mathbb{E}[R(T)] \le \sum_{i:\Delta_i>0}\frac{8\log T}{\Delta_i} + \Big(1+\tfrac{\pi^{2}}{3}\Big)\sum_{i}\Delta_i`,
	String.raw`R(T) \le \mathcal{O}\big(\sqrt{KT\log T}\big), \qquad R(T) \ge c\,\sqrt{KT}`,
	String.raw`\hat{\mu}_i(t) = \frac{1}{N_i(t)}\sum_{s=1}^{t} r_s\,\mathbf{1}\{a_s = i\}`,
	String.raw`\liminf_{T\to\infty}\frac{\mathbb{E}[N_i(T)]}{\log T} \ge \frac{1}{\mathrm{KL}(\mu_i,\mu^{*})}`,
	String.raw`\tilde{\theta}_t \sim p(\theta \mid \mathcal{H}_{t-1}), \qquad a_t = \arg\max_{a} \mathbb{E}\big[r \mid \tilde{\theta}_t, a\big]`,
	String.raw`w_{t+1}(i) \propto w_t(i)\,\exp\big(\eta\,\hat{r}_t(i)\big)`,
	String.raw`\pi(a|s) = \begin{cases} 1-\epsilon+\frac{\epsilon}{|\mathcal{A}|}, & a = a^{*} \\ \frac{\epsilon}{|\mathcal{A}|}, & \text{otherwise} \end{cases}`,
	// Concentration & online learning
	String.raw`\mathbb{P}\big(|\hat{\mu}-\mu|\ge \varepsilon\big) \le 2e^{-2n\varepsilon^{2}}`,
	String.raw`\mathbb{P}\Big(\Big|\sum_{t} X_t\Big| \ge \varepsilon\Big) \le 2\exp\Big(-\frac{\varepsilon^{2}}{2\sum_t c_t^{2}}\Big)`,
	String.raw`x_{t+1} = \Pi_{\mathcal{X}}\big(x_t - \eta\,\nabla f_t(x_t)\big)`,
	String.raw`\mathrm{Reg}(T) \le \frac{D^{2}}{2\eta} + \frac{\eta G^{2} T}{2} = \mathcal{O}\big(DG\sqrt{T}\big)`,
	String.raw`\sum_{t=1}^{T}\frac{1}{\sqrt{t}} \le 2\sqrt{T}`,
	String.raw`\mathrm{KL}(p\,\|\,q) = \sum_{x} p(x)\log\frac{p(x)}{q(x)}`,
	String.raw`\mathbb{E}_{p}[f(x)] = \mathbb{E}_{q}\Big[\tfrac{p(x)}{q(x)}\, f(x)\Big]`,
	// Bellman structure & policy improvement
	String.raw`Q^{\pi}(s,a) = r(s,a) + \gamma\,\mathbb{E}_{s'}\big[V^{\pi}(s')\big]`,
	String.raw`\pi'(s) = \arg\max_{a} Q^{\pi}(s,a) \;\Rightarrow\; V^{\pi'} \ge V^{\pi}`,
	String.raw`(\mathcal{T}V)(s) = \max_{a}\big\{ r(s,a) + \gamma\, \mathbb{E}\,V(s') \big\}`,
	String.raw`V^{*} = \max_{\pi} V^{\pi}, \qquad \pi^{*} = \arg\max_{\pi} J(\pi)`,
	String.raw`\sum_{t=0}^{\infty} \gamma^{t} = \frac{1}{1-\gamma}`,
	String.raw`G_t^{\lambda} = (1-\lambda)\sum_{n=1}^{\infty} \lambda^{n-1} G_{t:t+n}`,
	String.raw`G_{t:t+n} = \sum_{k=0}^{n-1}\gamma^{k} r_{t+k+1} + \gamma^{n} V(s_{t+n})`,
	String.raw`\min_{\theta}\; \mathbb{E}\big[\big( y - Q_{\theta}(s,a) \big)^{2}\big]`,
	String.raw`\pi(a|s) = \frac{e^{h(s,a)}}{\sum_{b} e^{h(s,b)}}`,
	String.raw`\theta \leftarrow \theta + \alpha\, F^{-1} \nabla_{\theta} J(\theta)`,
	String.raw`F = \mathbb{E}\big[\nabla\log\pi_{\theta}\, \nabla\log\pi_{\theta}^{\top}\big]`,
	String.raw`\mathbb{P}(s_{t+1} \mid s_t, a_t, \ldots, s_0) = \mathbb{P}(s_{t+1} \mid s_t, a_t)`,
	String.raw`\rho^{\top} P = \rho^{\top}, \qquad \sum_{s}\rho(s) = 1`,
	// Bandits & concentration, extended
	String.raw`R(T) = \sum_{i} \Delta_i\, \mathbb{E}\big[N_i(T)\big]`,
	String.raw`|\hat{\mu}-\mu| \le \sqrt{\tfrac{2\sigma^{2}\log(1/\delta)}{n}} + \tfrac{c\log(1/\delta)}{3n}`,
	String.raw`p_i(t) = (1-\gamma)\frac{w_i(t)}{\sum_j w_j(t)} + \frac{\gamma}{K}`,
	String.raw`\hat{r}_i(t) = \frac{r_t\,\mathbf{1}\{a_t = i\}}{p_i(t)}`,
	String.raw`\mathrm{Beta}(\alpha + r,\; \beta + 1 - r)`,
	String.raw`p(\theta \mid \mathcal{D}) \propto p(\mathcal{D} \mid \theta)\, p(\theta)`,
	String.raw`\mathbb{E}\big[e^{\lambda X}\big] \le e^{\lambda^{2}\sigma^{2}/2}`,
	String.raw`\mathbb{E}\big[X_{t+1} \mid \mathcal{F}_t\big] = X_t`,
	String.raw`\mathbb{P}\Big(\bigcup_i A_i\Big) \le \sum_i \mathbb{P}(A_i)`,
	String.raw`\mathbb{P}(X \ge a) \le \frac{\mathbb{E}[X]}{a}`,
	String.raw`f\big(\mathbb{E}[X]\big) \le \mathbb{E}\big[f(X)\big]`,
	// Online learning, extended
	String.raw`x_{t+1} = \arg\min_{x}\; \eta\,\langle g_t, x\rangle + D_{\psi}(x, x_t)`,
	String.raw`x_{t+1} = \arg\min_{x}\; \sum_{s=1}^{t}\langle g_s, x\rangle + \tfrac{1}{\eta}\psi(x)`,
	String.raw`f(y) \ge f(x) + \langle \nabla f(x), y-x\rangle + \tfrac{\mu}{2}\|y-x\|^{2}`,
];

const notes = [
	"Algorithm 1: Q-learning",
	"by Hoeffding's inequality,",
	"w.p. at least 1 − δ,",
	"by the contraction mapping theorem,",
	"Lemma 1 (performance difference).",
	"telescoping over t = 1, …, T:",
	"taking expectation over s′ ∼ P(·|s,a),",
	"exploration vs. exploitation:",
	"Q.E.D.  □",
];

// Named theorems and terminology, set in the display serif — half the field.
const terms = [
	"Azuma–Hoeffding inequality",
	"Bellman optimality equation",
	"Markov decision process",
	"exploration–exploitation trade-off",
	"optimism in the face of uncertainty",
	"upper confidence bound",
	"Thompson sampling",
	"regret minimization",
	"Lai–Robbins lower bound",
	"minimax regret",
	"contraction mapping theorem",
	"temporal-difference learning",
	"policy gradient theorem",
	"actor–critic methods",
	"trust-region policy optimization",
	"maximum-entropy reinforcement learning",
	"Boltzmann exploration",
	"eligibility traces",
	"stochastic approximation",
	"martingale difference sequence",
	"sub-Gaussian concentration",
	"union bound",
	"Chernoff bound",
	"importance sampling",
	"off-policy evaluation",
	"occupancy measure",
	"contextual bandits",
	"adversarial bandits",
	"online convex optimization",
	"mirror descent",
	"follow-the-regularized-leader",
	"Lyapunov stability",
	"sample complexity",
	"value iteration · policy iteration",
	"dynamic programming principle",
	"Bellman operator",
	"Robbins–Monro conditions",
	"Bellman backup · bootstrapping",
	"generalized advantage estimation",
	"natural policy gradient",
	"Fisher information matrix",
	"Kullback–Leibler divergence",
	"successive elimination",
	"doubling trick",
	"best-arm identification",
	"pure exploration",
	"confidence radius",
	"Bernstein inequality",
	"McDiarmid's inequality",
	"optional stopping theorem",
	"Markov property",
	"stationary distribution",
	"ergodicity · mixing time",
	"credit assignment problem",
	"reward shaping",
	"function approximation",
	"the deadly triad",
	"experience replay",
	"target network",
	"distributional reinforcement learning",
	"model-based · model-free",
	"offline reinforcement learning",
	"behavior cloning",
	"inverse reinforcement learning",
	"partial observability",
	"belief state",
	"bandit feedback",
	"minimax lower bound",
	"gap-dependent regret",
	"anytime algorithm",
	"Jensen's inequality",
	"Fenchel duality",
	"Frank–Wolfe method",
	"proximal operator",
	"no-regret learning",
	"self-normalized concentration",
];

// Compile each unique formula once; slots below reuse the cached SVG.
const compiled = formulas.map((tex) => typeset(tex));
const sharedGlyphDefs = (() => {
	try {
		// With fontCache: "global", glyph paths live in one shared defs block.
		const cache = (svgOutput as unknown as { fontCache: { getCache(): unknown } })
			.fontCache.getCache();
		return adaptor.outerHTML(cache as Parameters<typeof adaptor.outerHTML>[0]);
	} catch {
		return "";
	}
})();

// Ambient field layout: lines spread over the whole viewport (the layer is
// fixed), each drifting in and out on its own staggered cycle so roughly a
// third of them are visible at any moment. Deterministic LCG keeps builds
// reproducible.
const lcg = (() => {
	let seed = 987654321;
	return () => {
		seed = (seed * 48271) % 2147483647;
		return seed / 2147483647;
	};
})();

type Line = {
	kind: "math" | "term" | "note";
	html: string;
	top: number;
	left: number;
	size: number;
	duration: number;
	delay: number;
};

const SLOTS = 66;
const lines: Line[] = [];
let mathIndex = 0;
let termIndex = 0;
let noteIndex = 0;
let textSlot = 0;

for (let i = 0; i < SLOTS; i++) {
	// Even slots carry compiled math; odd slots carry prose (mostly named
	// theorems/terminology, every 4th a mono proof annotation) — about 50/50.
	const isText = i % 2 === 1;
	const duration = 7 + Math.round(lcg() * 6);
	const top = Math.round((3 + lcg() * 90) * 10) / 10;
	const left = Math.round((2 + lcg() * 86) * 10) / 10;
	const size = Math.round((0.7 + lcg() * 0.5) * 100) / 100;
	const baseDelay = -Math.round(lcg() * duration * 10) / 10;

	// Two phase-shifted entries share each position, so every spot alternates
	// between different content — the full libraries enter the rotation.
	for (let variant = 0; variant < 2; variant++) {
		const isNote = isText && textSlot % 4 === 3;
		const line: Line = {
			kind: isText ? (isNote ? "note" : "term") : "math",
			html: "",
			top,
			left,
			size,
			duration,
			delay: Math.round((baseDelay - (variant * duration) / 2) * 10) / 10,
		};

		if (isText) {
			if (isNote) {
				line.html = notes[noteIndex % notes.length];
				noteIndex++;
			} else {
				line.html = terms[termIndex % terms.length];
				termIndex++;
			}
			textSlot++;
		} else {
			line.html = compiled[mathIndex % compiled.length];
			mathIndex++;
		}

		lines.push(line);
	}
}
---

<div class="manuscript-layer" aria-hidden="true">
	<svg class="ms-defs" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={sharedGlyphDefs} />
	{
		lines.map((line) =>
			line.kind === "math" ? (
				<div
					class="ms-line"
					style={`top:${line.top}%; left:${line.left}%; font-size:${line.size}em; --dur:${line.duration}s; --delay:${line.delay}s;`}
					set:html={line.html}
				/>
			) : (
				<span
					class:list={["ms-line", line.kind === "term" ? "ms-term" : "ms-note"]}
					style={`top:${line.top}%; left:${line.left}%; font-size:${line.size}em; --dur:${line.duration}s; --delay:${line.delay}s;`}
				>
					{line.html}
				</span>
			),
		)
	}
</div>

<style>
	.manuscript-layer {
		position: fixed;
		inset: 0;
		overflow: hidden;
		z-index: 0;
		font-size: 0.92rem;
		color: var(--text-primary);
		opacity: 0.2;
		pointer-events: none;
		user-select: none;
		/* Whole-page field, but the reading column stays subdued. */
		-webkit-mask-image: linear-gradient(
			90deg,
			rgba(0, 0, 0, 1) 0%,
			rgba(0, 0, 0, 1) 13%,
			rgba(0, 0, 0, 0.38) 26%,
			rgba(0, 0, 0, 0.38) 74%,
			rgba(0, 0, 0, 1) 87%,
			rgba(0, 0, 0, 1) 100%
		);
		mask-image: linear-gradient(
			90deg,
			rgba(0, 0, 0, 1) 0%,
			rgba(0, 0, 0, 1) 13%,
			rgba(0, 0, 0, 0.38) 26%,
			rgba(0, 0, 0, 0.38) 74%,
			rgba(0, 0, 0, 1) 87%,
			rgba(0, 0, 0, 1) 100%
		);
	}

	html[data-theme="dark"] .manuscript-layer {
		opacity: 0.18;
	}

	.ms-defs {
		position: absolute;
		width: 0;
		height: 0;
		overflow: hidden;
	}

	.ms-line {
		position: absolute;
		white-space: nowrap;
		line-height: 1;
		opacity: 0;
		animation: ms-cycle var(--dur, 18s) linear infinite;
		animation-delay: var(--delay, 0s);
	}

	/* Float up, linger, dissolve — visible for roughly a third of each cycle. */
	@keyframes ms-cycle {
		0% {
			opacity: 0;
			transform: translateY(18px);
		}
		9% {
			opacity: 1;
		}
		25% {
			opacity: 1;
		}
		34% {
			opacity: 0;
			transform: translateY(-24px);
		}
		100% {
			opacity: 0;
			transform: translateY(-24px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ms-line {
			animation: none;
			opacity: 0.5;
		}
	}

	.ms-line :global(svg) {
		display: block;
	}

	.ms-note {
		font-family: var(--font-mono);
		font-size: 0.78em;
		letter-spacing: 0.08em;
		color: var(--text-secondary);
	}

	/* Named theorems / terminology: display serif italic, like index entries. */
	.ms-term {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 430;
		letter-spacing: 0.015em;
		font-variation-settings:
			"opsz" 40,
			"SOFT" 50;
	}

	@media screen and (max-width: 1023px) {
		.manuscript-layer {
			display: none;
		}
	}

	@media print {
		.manuscript-layer {
			display: none;
		}
	}
</style>
