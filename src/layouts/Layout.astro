---
import "../styles/reset.css";
import "../styles/globals.css";

import { name, twitterHandle } from "homepage:globals";
import Background from "../components/Background.astro";
import LayoutGrid from "../components/LayoutGrid.astro";
import ManuscriptLayer from "../components/ManuscriptLayer.astro";
import Navbar from "../components/Navbar.astro";
import SnakeGame from "../components/SnakeGame.astro";

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata;
	layout?: "split" | "single" | "home";
	ambient?: "manuscript" | "none";
	article?: {
		createdAt: Date;
		updatedAt?: Date;
	};
}

const {
	title,
	description,
	image,
	article,
	layout = "split",
	ambient = "manuscript",
} = Astro.props;
const lightThemeColor = "#f4efe4";
const darkThemeColor = "#15130f";
const isHomeLayout = layout === "home";
const initialThemeColor = isHomeLayout ? "#1735d6" : darkThemeColor;
const currentYear = new Date().getFullYear();
// Scrapers (WeChat, Twitter, Slack) require absolute URLs in og:/twitter: image tags.
const socialImage = new URL(image?.src ?? "/img/og.png", Astro.site).href;
---

<!DOCTYPE html>
<html
	lang="en"
	data-theme="dark"
	data-home-hero={layout === "home" ? "passed" : undefined}
>
	<head>
		<script is:inline data-nav-enhancement>
			document.documentElement.dataset.navJs = "ready";
		</script>
		<link rel="preload" href="/fonts/Geist.woff2" as="font" type="font/woff2" crossorigin="">
		<link rel="preload" href="/fonts/GeistMono.woff2" as="font" type="font/woff2" crossorigin="">

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,0..100;1,9..144,300..600,0..100&display=swap"
		/>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon-bird.png" />
		<link rel="shortcut icon" type="image/png" href="/favicon-bird.png" />
		<link rel="apple-touch-icon" href="/favicon-bird.png" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<meta name="theme-color" content={initialThemeColor}>
		<script is:inline define:vars={{ lightThemeColor, darkThemeColor, isHomeLayout }}>
			(() => {
				const storageKey = "homepage-theme";
				const storedTheme = localStorage.getItem(storageKey);
				const theme = storedTheme === "light" ? "light" : "dark";
				document.documentElement.dataset.theme = theme;
				document.documentElement.style.colorScheme = theme;
				const themeMeta = document.querySelector('meta[name="theme-color"]');
				if (themeMeta) {
					themeMeta.setAttribute(
						"content",
						isHomeLayout ? "#1735d6" : theme === "dark" ? darkThemeColor : lightThemeColor,
					);
				}
			})();
		</script>

		<link rel="canonical" href={Astro.url} />

		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:image" content={socialImage} />
		<meta property="og:url" content={Astro.url} />
		{!article && <meta property="og:type" content="website" />}
		<meta property="og:locale" content="en" />

		{article && (
			<meta property="og:type" content="article" />
			<meta property="article:published_time" content={article.createdAt.toISOString()} />
			<meta name="author" content={name} />
		)}

		{article && article.updatedAt && (
			<meta property="article:modified_time" content={article.updatedAt.toISOString()} />
		)}

		<meta name="twitter:card" content="summary_large_image" />
		{twitterHandle && (
			<meta name="twitter:site" content={twitterHandle} />
			<meta name="twitter:creator" content={twitterHandle} />
		)}
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={socialImage} />
	</head>
	<body class:list={[layout === "home" && "page-home"]}>
		{ambient === "manuscript" && <ManuscriptLayer />}
		<main
			class:list={[
				layout === "single" && "main-single",
				layout === "home" && "main-home",
			]}
			data-layout={layout}
		>
			<Navbar variant={layout === "home" ? "atlas" : "default"} />
			{
				layout === "split" ? (
				<LayoutGrid>
					<slot name="left" slot="left" />
					<slot name="right" slot="right" />
				</LayoutGrid>
				) : (
					<LayoutGrid variant={layout}>
						<slot />
					</LayoutGrid>
				)
			}
			<slot name="404" />
			<footer class:list={["site-footer", layout === "single" && "site-footer-single"]}>
				<hr class="hairline" />
				<div class="site-footer-credit">
					<p>
						&copy; {currentYear} Hengquan Guo. Powered by
						<a href="https://openai.com/codex/" target="_blank" rel="noopener noreferrer">Codex</a>
						&amp;
						<a href="https://www.anthropic.com/claude-code" target="_blank" rel="noopener noreferrer">Claude Code</a>.
					</p>
					<SnakeGame />
				</div>
				<div class="snake-board-wrap" id="snake-board-wrap">
					<div class="snake-board" id="snake-board"></div>
				</div>
			</footer>
		</main>
		<Background />
	</body>
</html>

<style is:global>
	.site-footer {
		margin-top: 2.5rem;
		padding-bottom: 2.5rem;
		font-family: var(--font-sans);
		font-size: 0.78rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0;
		color: var(--text-tertiary);
		text-align: center;
	}

	.site-footer .hairline {
		margin-bottom: 1.25rem;
	}

	.site-footer p {
		margin: 0;
	}

	.site-footer-credit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		max-width: 100%;
	}

	.site-footer a {
		color: var(--text-secondary);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.site-footer a:hover,
	.site-footer a:focus-visible {
		color: var(--text-primary);
		border-bottom-color: var(--primary);
		outline: none;
	}

	.site-footer-single {
		max-width: 960px;
		margin-left: auto;
		margin-right: auto;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
	}

	@media screen and (max-width: 640px) {
		.site-footer {
			margin-top: 2rem;
			padding-bottom: 2rem;
		}
	}
</style>
